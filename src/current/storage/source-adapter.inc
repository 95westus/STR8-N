        INCLUDE "../source-store/state.inc"

; Appended inside the version-paired B2 utility integrity domain.
; Normal SRAM operations retain their original range contract.
NS_STORAGE:
 JSR SM_INIT
 LDA #1
 STA NS_ACTIVE
 LDA #<NS_REQUEST
 LDX #>NS_REQUEST
 JSR SM_C_API
 STZ NS_ACTIVE
 RTS
NS_CHECKED_RANGE:
 JSR SM_C_RANGE_CHECK
 BNE NS_RANGE_RETURN
 LDA NS_ACTIVE
 BEQ NS_RANGE_RETURN
 LDA SM_D_LOAD
 BNE NS_RANGE_BAD
 LDA SM_D_LOAD+1
 CMP #2
 BNE NS_RANGE_BAD
 LDA SM_D_ENTRY
 ORA SM_D_ENTRY+1
 BNE NS_RANGE_BAD
 LDA SM_D_LENGTH+1
 CMP #$1C
 BCC NS_RANGE_MINIMUM
 BNE NS_RANGE_BAD
 LDA SM_D_LENGTH
 CMP #9
 BCS NS_RANGE_BAD
NS_RANGE_MINIMUM:
 LDA SM_D_LENGTH+1
 BNE NS_RANGE_ACCEPT
 LDA SM_D_LENGTH
 CMP #8
 BCC NS_RANGE_BAD
NS_RANGE_ACCEPT:
 LDA SM_D_LENGTH
 STA NS_STORED_LENGTH
 LDA SM_D_LENGTH+1
 STA NS_STORED_LENGTH+1
 LDA #0
NS_RANGE_RETURN:
 RTS
NS_RANGE_BAD:
 LDA #$44
 RTS

