DECODE:
 LDA DP
 STA PTR
 LDA DP+1
 STA PTR+1
 LDA (PTR)
 STA DBYTES
 STZ DBYTES+1
 STZ DBYTES+2
 ; RMB/SMB/BBR/BBS bytes are different instructions on an 816, even E=1.
 ; Share ASM's common instruction subset without misdecoding those bytes.
 LDA $7D01
 CMP #$16
 BNE DS_TABLE
 LDA DBYTES
 AND #7
 CMP #7
 BEQ DS_UNKNOWN
DS_TABLE:
 LDA #<AS_OP_TABLE
 STA TABLE
 LDA #>AS_OP_TABLE
 STA TABLE+1
DS_SCAN:
 LDY #5
 LDA (TABLE),Y
 CMP DBYTES
 BEQ DS_FOUND
 CLC
 LDA TABLE
 ADC #6
 STA TABLE
 BCC DS_SCAN_END
 INC TABLE+1
DS_SCAN_END:
 LDA TABLE+1
 CMP #>AS_OP_END
 BCC DS_SCAN
 BNE DS_UNKNOWN
 LDA TABLE
 CMP #<AS_OP_END
 BCC DS_SCAN
DS_UNKNOWN:
 LDA #$FF
 STA DMODE
 LDA #1
 BRA DS_SET_LENGTH
DS_FOUND:
 LDY #4
 LDA (TABLE),Y
 LDX DBYTES
 BNE DS_SET_MODE
 LDA #3
DS_SET_MODE:
 STA DMODE
 TAX
 LDA AS_LENGTHS,X
DS_SET_LENGTH:
 STA DLEN
 LDY #1
DS_FETCH_OPERAND:
 CPY DLEN
 BCS DS_DECODE_DONE
 TYA
 CLC
 ADC DP
 LDA DP+1
 ADC #0
 CMP #$67
 BCS DS_TRUNCATED
 CMP #$65
 BCC DS_FETCH_SAFE
 BIT $7D0C
 BMI DS_TRUNCATED
DS_FETCH_SAFE:
 LDA (PTR),Y
 STA DBYTES,Y
 INY
 BRA DS_FETCH_OPERAND
DS_TRUNCATED:
 LDA #$FF
 STA DMODE
 LDA #1
 STA DLEN
DS_DECODE_DONE:
 RTS
DISASM:
 JSR DECODE
 LDA DP+1
 JSR HEX
 LDA DP
 JSR HEX
 LDA #' '
 JSR PUTC
 LDX #0
DS_RAW:
 CPX DLEN
 BCS DS_RAW_BLANK
 LDA DBYTES,X
 JSR HEX
 BRA DS_RAW_SPACE
DS_RAW_BLANK:
 LDA #' '
 JSR PUTC
 JSR PUTC
DS_RAW_SPACE:
 LDA #' '
 JSR PUTC
 INX
 CPX #3
 BNE DS_RAW
 LDA DMODE
 BMI DS_BAD_OPCODE
 LDY #0
DS_NAME:
 LDA (TABLE),Y
 BEQ DS_NAME_DONE
 JSR PUTC
 INY
 CPY #4
 BNE DS_NAME
DS_NAME_DONE:
 LDX DMODE
 LDA DS_FORMATS,X
 TAX
 BRA DS_FORMAT
DS_BAD_OPCODE:
 LDX #0
DS_BAD_NAME:
 LDA DS_BYTE_NAME,X
 BEQ DS_BAD_FORMAT
 JSR PUTC
 INX
 BRA DS_BAD_NAME
DS_BAD_FORMAT:
 LDX #DS_F_BYTE-DS_FORMAT_DATA
DS_FORMAT:
 LDA DS_FORMAT_DATA,X
 BEQ DS_DONE
 CMP #6
 BCC DS_TOKEN
 JSR PUTC
 BRA DS_FORMAT_NEXT
DS_TOKEN:
 CMP #5
 BEQ DS_OPCODE_OPERAND
 CMP #1
 BEQ DS_BYTE_OPERAND
 CMP #2
 BEQ DS_WORD_OPERAND
 CMP #4
 BEQ DS_RELATIVE_SECOND
 LDY #1
 BRA DS_RELATIVE
DS_RELATIVE_SECOND:
 LDY #2
DS_RELATIVE:
 PHX
 CLC
 LDA DP
 ADC DLEN
 STA DTARGET
 LDA DP+1
 ADC #0
 STA DTARGET+1
 LDA DBYTES,Y
 LDX #0
 CMP #$80
 BCC DS_RELATIVE_POSITIVE
 DEX
DS_RELATIVE_POSITIVE:
 CLC
 ADC DTARGET
 STA DTARGET
 TXA
 ADC DTARGET+1
 JSR HEX
 LDA DTARGET
 JSR HEX
 PLX
 BRA DS_FORMAT_NEXT
DS_WORD_OPERAND:
 LDA DBYTES+2
 JSR HEX
DS_BYTE_OPERAND:
 LDA DBYTES+1
 JSR HEX
 BRA DS_FORMAT_NEXT
DS_OPCODE_OPERAND:
 LDA DBYTES
 JSR HEX
DS_FORMAT_NEXT:
 INX
 BRA DS_FORMAT
DS_DONE:
 JSR NL
 CLC
 LDA DP
 ADC DLEN
 STA DP
 BCC DS_RETURN
 INC DP+1
DS_RETURN:
 RTS
DS_BYTE_NAME DB ".BYTE",0
DS_FORMATS:
 DB DS_F_IMP-DS_FORMAT_DATA,DS_F_ACC-DS_FORMAT_DATA,DS_F_IMM-DS_FORMAT_DATA,DS_F_ZPG-DS_FORMAT_DATA
 DB DS_F_ZPX-DS_FORMAT_DATA,DS_F_ZPY-DS_FORMAT_DATA,DS_F_ABS-DS_FORMAT_DATA,DS_F_ABX-DS_FORMAT_DATA
 DB DS_F_ABY-DS_FORMAT_DATA,DS_F_INX-DS_FORMAT_DATA,DS_F_INY-DS_FORMAT_DATA,DS_F_ZPI-DS_FORMAT_DATA
 DB DS_F_IND-DS_FORMAT_DATA,DS_F_IAX-DS_FORMAT_DATA,DS_F_REL-DS_FORMAT_DATA,DS_F_ZPR-DS_FORMAT_DATA
DS_FORMAT_DATA:
DS_F_IMP DB 0
DS_F_ACC DB " A",0
DS_F_IMM DB " #$",1,0
DS_F_ZPG DB " $",1,0
DS_F_ZPX DB " $",1,",X",0
DS_F_ZPY DB " $",1,",Y",0
DS_F_ABS DB " $",2,0
DS_F_ABX DB " $",2,",X",0
DS_F_ABY DB " $",2,",Y",0
DS_F_INX DB " ($",1,",X)",0
DS_F_INY DB " ($",1,"),Y",0
DS_F_ZPI DB " ($",1,")",0
DS_F_IND DB " ($",2,")",0
DS_F_IAX DB " ($",2,",X)",0
DS_F_REL DB " $",3,0
DS_F_ZPR DB " $",1,",$",4,0
DS_F_BYTE DB " $",5,0
