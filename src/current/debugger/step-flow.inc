FLOW_STEP:
 STZ RESULT
 LDA PC
 STA PTR
 LDA PC+1
 STA PTR+1
 LDA (PTR)
 STA OP
 CMP #$80
 BNE NOT_BRA
 JMP REL_ONE
NOT_BRA:
 AND #$1F
 CMP #$10
 BNE NOT_BRANCH
 JMP BRANCH
NOT_BRANCH:
 LDA OP
 AND #$0F
 CMP #$0F
 BNE NOT_BIT_BRANCH
 JMP BIT_BRANCH
NOT_BIT_BRANCH:
 LDA OP
 CMP #$4C
 BNE NOT_JMP
 JMP ABSOLUTE
NOT_JMP:
 CMP #$6C
 BEQ INDIRECT
 CMP #$7C
 BEQ INDIRECT
 CMP #$20
 BNE NOT_JSR
 JMP CALL
NOT_JSR:
 CMP #$60
 BNE NOT_RTS
 JMP RETURN_SUB
NOT_RTS:
 CMP #$40
 BNE NOT_RTI
 JMP RETURN_IRQ
NOT_RTI:
 CMP #0
 BEQ BREAK_OP
 CMP #$CB
 BEQ UNSUPPORTED
 CMP #$DB
 BEQ UNSUPPORTED
 RTS
BREAK_OP:
 LDA #3
 STA RESULT
 RTS
UNSUPPORTED:
 LDA #2
 STA RESULT
 RTS
INDIRECT:
 LDY #1
 LDA (PTR),Y
 STA IND
 INY
 LDA (PTR),Y
 STA IND+1
 LDA OP
 CMP #$7C
 BNE INDIRECT_READ
 CLC
 LDA IND
 ADC REG_X
 STA IND
 BCC INDIRECT_READ
 INC IND+1
INDIRECT_READ:
 JSR READ_IND
 STA PC
 INC IND
 BNE INDIRECT_HIGH
 INC IND+1
INDIRECT_HIGH:
 JSR READ_IND
 STA PC+1
 JMP EMULATED
READ_IND:
 LDY IND+1
 BEQ READ_ZP
 CPY #1
 BEQ READ_STACK
 LDA (IND)
 RTS
READ_ZP:
 LDX IND
 LDA ZP_IMAGE,X
 RTS
READ_STACK:
 LDX IND
 LDA STACK_IMAGE,X
 RTS
ABSOLUTE:
 LDY #1
 LDA (PTR),Y
 STA PC
 INY
 LDA (PTR),Y
 STA PC+1
 JMP EMULATED
CALL:
 CLC
 LDA PC
 ADC #2
 STA TMP
 LDA PC+1
 ADC #0
 JSR PUSH_IMAGE
 LDA TMP
 JSR PUSH_IMAGE
 JMP ABSOLUTE
RETURN_SUB:
 JSR POP_IMAGE
 STA PC
 JSR POP_IMAGE
 STA PC+1
 INC PC
 BNE RETURN_SUB_DONE
 INC PC+1
RETURN_SUB_DONE:
 JMP EMULATED
RETURN_IRQ:
 JSR POP_IMAGE
 ORA #$20
 AND #$EF
 STA REG_P
 JSR POP_IMAGE
 STA PC
 JSR POP_IMAGE
 STA PC+1
 JMP EMULATED
PUSH_IMAGE:
 LDX REG_SP
 STA STACK_IMAGE,X
 DEC REG_SP
 RTS
POP_IMAGE:
 INC REG_SP
 LDX REG_SP
 LDA STACK_IMAGE,X
 RTS
BRANCH:
 LDA OP
 LSR A
 LSR A
 LSR A
 LSR A
 LSR A
 TAX
 LDA FLAG_MASK,X
 AND REG_P
 STA TMP
 LDA OP
 AND #$20
 BEQ BRANCH_CLEAR
 LDA TMP
 BNE REL_ONE
 BRA SKIP_TWO
BRANCH_CLEAR:
 LDA TMP
 BEQ REL_ONE
SKIP_TWO:
 LDA #2
 JMP ADVANCE
REL_ONE:
 LDY #1
 BRA RELATIVE
BIT_BRANCH:
 LDA OP
 LSR A
 LSR A
 LSR A
 LSR A
 AND #7
 TAX
 LDA BIT_MASK,X
 STA TMP
 LDY #1
 LDA (PTR),Y
 TAX
 LDA ZP_IMAGE,X
 AND TMP
 STA TMP
 LDA OP
 BMI BIT_SET
 LDA TMP
 BEQ REL_TWO
 BRA SKIP_THREE
BIT_SET:
 LDA TMP
 BNE REL_TWO
SKIP_THREE:
 LDA #3
 JMP ADVANCE
REL_TWO:
 LDY #2
RELATIVE:
 LDA (PTR),Y
 STA TMP
 TYA
 SEC
 ADC PC
 STA PC
 BCC REL_SIGN
 INC PC+1
REL_SIGN:
 LDX #0
 LDA TMP
 BPL REL_ADD
 DEX
REL_ADD:
 CLC
 ADC PC
 STA PC
 TXA
 ADC PC+1
 STA PC+1
 BRA EMULATED
ADVANCE:
 CLC
 ADC PC
 STA PC
 BCC EMULATED
 INC PC+1
EMULATED:
 LDA #1
 STA RESULT
 RTS
FLAG_MASK DB $80,$80,$40,$40,$01,$01,$02,$02
BIT_MASK DB $01,$02,$04,$08,$10,$20,$40,$80
