SM_C_WRITE_VERIFY:
        JSR SM_C_BUF_POINTER
        LDA #64
        STA SM_D_COUNT
SM_C_WRITE_VERIFY_COUNT:
        LDX SM_D_COUNT
        DEX
SM_C_VERIFY_BACKUP:
        LDA SM_C_BUF,X
        STA SM_C_EXPECTED,X
        DEX
                        BPL SM_C_VERIFY_BACKUP
        LDA #2
        JSR SM_C_TRANSFER
                        BNE SM_C_WRITE_RETURN
        LDA #1
        JSR SM_C_TRANSFER
                        BNE SM_C_WRITE_RETURN
        LDX SM_D_COUNT
        DEX
SM_C_VERIFY_COMPARE:
        LDA SM_C_BUF,X
        CMP SM_C_EXPECTED,X
                        BNE SM_C_CRC_BAD
        DEX
                        BPL SM_C_VERIFY_COMPARE
        LDA #0
SM_C_WRITE_RETURN:
        RTS
SM_C_CRC_BAD:LDA #$45
        RTS
SM_C_LOAD_RECORD:
        LDY #4
        LDA (SM_C_REC),Y
        STA SM_D_LOAD
        INY
        LDA (SM_C_REC),Y
        STA SM_D_LOAD+1
        INY
        LDA (SM_C_REC),Y
        STA SM_D_LENGTH
        INY
        LDA (SM_C_REC),Y
        STA SM_D_LENGTH+1
        INY
        LDA (SM_C_REC),Y
        STA SM_D_ENTRY
        INY
        LDA (SM_C_REC),Y
        STA SM_D_ENTRY+1
        LDY #14
        LDA (SM_C_REC),Y
        STA SM_D_ADDR+1
        STZ SM_D_ADDR
SM_C_SET_LEFT:
        LDA SM_D_LENGTH
        STA SM_D_LEFT
        LDA SM_D_LENGTH+1
        STA SM_D_LEFT+1
        RTS
SM_C_CHUNK:  LDA #64
        LDX SM_D_LEFT+1
                        BNE SM_C_CHUNK_DONE
        CMP SM_D_LEFT
                        BCC SM_C_CHUNK_DONE
        LDA SM_D_LEFT
SM_C_CHUNK_DONE:
        STA SM_D_COUNT
        RTS
SM_C_ADVANCE:
        CLC
        LDA SM_D_BP
        ADC SM_D_COUNT
        STA SM_D_BP
                        BCC SM_C_ADVANCE_ADDR
        INC SM_D_BP+1
SM_C_ADVANCE_ADDR:
        CLC
        LDA SM_D_ADDR
        ADC SM_D_COUNT
        STA SM_D_ADDR
                        BCC SM_C_ADVANCE_LEFT
        INC SM_D_ADDR+1
SM_C_ADVANCE_LEFT:
        SEC
        LDA SM_D_LEFT
        SBC SM_D_COUNT
        STA SM_D_LEFT
        LDA SM_D_LEFT+1
        SBC #0
        STA SM_D_LEFT+1
        ORA SM_D_LEFT
        RTS
SM_C_DEC_LEFT:
        LDA SM_D_LEFT
                        BNE SM_C_DEC_LOW
        DEC SM_D_LEFT+1
SM_C_DEC_LOW:DEC SM_D_LEFT
        LDA SM_D_LEFT
        ORA SM_D_LEFT+1
        RTS
SM_C_VERIFY_PAYLOAD:
        JSR SM_C_LOAD_RECORD
        JSR SM_C_CRC_INIT
SM_C_PAYLOAD_LOOP:
        JSR SM_C_BUF_POINTER
        JSR SM_C_CHUNK
        LDA #1
        JSR SM_C_TRANSFER
                        BNE SM_C_PAYLOAD_RETURN
        LDY #0
SM_C_PAYLOAD_CRC:
        LDA SM_C_BUF,Y
        JSR SM_C_CRC_BYTE
        INY
        CPY SM_D_COUNT
                        BNE SM_C_PAYLOAD_CRC
        JSR SM_C_ADVANCE
                        BNE SM_C_PAYLOAD_LOOP
        LDY #12
        LDA (SM_C_REC),Y
        CMP SM_D_CRC
                        BNE SM_C_CRC_BAD
        INY
        LDA (SM_C_REC),Y
        CMP SM_D_CRC+1
                        BNE SM_C_CRC_BAD
        LDA #0
SM_C_PAYLOAD_RETURN:
        RTS
SM_C_RESTORE:
        JSR SM_C_LOAD_RECORD
        JSR SW_COPY_RANGE
        BNE SM_C_SAVE_RETURN
        JSR SM_C_RANGE_CHECK
                        BNE SM_C_SAVE_RETURN
        LDA SM_C_REQUEST
        CMP #3
                        BNE SM_C_RESTORE_BEGIN
        LDA SM_D_ENTRY
        ORA SM_D_ENTRY+1
                        BEQ SM_C_NO_RUN
SM_C_RESTORE_BEGIN:
        JSR SM_C_RESTORE_BUF
        JSR SM_S_COPY_BEGIN
        LDA SM_D_LOAD
        STA SM_D_BP
        LDA SM_D_LOAD+1
        STA SM_D_BP+1
        JSR SM_C_CRC_INIT
SM_C_RESTORE_LOOP:
        JSR SM_C_CHUNK
        JSR SM_S_RESTORE_TRANSFER
                        BNE SM_C_PARTIAL
        LDA SM_D_BP
        STA SM_C_PTR
        LDA SM_D_BP+1
        STA SM_C_PTR+1
        LDY #0
SM_C_RESTORE_CRC:
        JSR SM_S_SOURCE_BYTE
        JSR SM_C_CRC_BYTE
        INY
        CPY SM_D_COUNT
                        BNE SM_C_RESTORE_CRC
        JSR SM_C_ADVANCE
                        BNE SM_C_RESTORE_LOOP
        LDY #12
        LDA (SM_C_REC),Y
        CMP SM_D_CRC
                        BNE SM_C_PARTIAL
        INY
        LDA (SM_C_REC),Y
        CMP SM_D_CRC+1
                        BNE SM_C_PARTIAL
        LDA SM_C_REQUEST
        CMP #3
                        BNE SM_C_RESTORE_OK
        LDA SM_D_ENTRY
        STA $FE
        LDA SM_D_ENTRY+1
        STA $FF
        JSR SW_RUN_CHECK
        BCS B29_APP_OK
        LDA #$4A
        JMP SM_C_FINISH
B29_APP_OK:
        JMP SW_RUN
SM_C_RESTORE_OK:
        LDA #0
        JMP SM_C_FINISH
SM_C_PARTIAL:LDA #$46
        JMP SM_C_FINISH
SM_C_NO_RUN: LDA #$47
        JMP SM_C_FINISH
; Bounded reclaim: only superseded records. Validate newest live payload first.
; Tombstones remain until FORMAT; no data moves and no automatic collection.
SM_C_RECLAIM:
        STZ SM_D_GC_INDEX
        STZ SM_D_GC_PASS
SM_C_GC_LOOP:
        LDA SM_D_GC_INDEX
        STA SM_D_INDEX
        JSR SM_C_INDEX_REC
        LDY #3
        LDA (SM_C_REC),Y
        CMP #$A5
                        BNE SM_C_GC_NEXT
        LDY #16
        LDX #0
SM_C_GC_NAME:
        LDA (SM_C_REC),Y
        STA SM_C_REQUEST+8,X
        INY
        INX
        CPX #16
                        BNE SM_C_GC_NAME
        JSR SM_C_FIND_NAME
                        BNE SM_C_GC_RETURN
        LDA SM_D_BEST
        CMP SM_D_GC_INDEX
                        BNE SM_C_GC_SUPERSEDED
        LDA SM_D_GC_PASS
                        BEQ SM_C_GC_NEXT
        JSR SM_C_BEST_REC
        LDY #15
        LDA (SM_C_REC),Y
        CMP #2
                        BEQ SM_C_GC_CLEAR
                        BRA SM_C_GC_NEXT
SM_C_GC_SUPERSEDED:
        JSR SM_C_BEST_REC
        LDY #15
        LDA (SM_C_REC),Y
        CMP #1
                        BNE SM_C_GC_CLEAR
        JSR SM_C_VERIFY_PAYLOAD
                        BNE SM_C_GC_RETURN
SM_C_GC_CLEAR:
        LDA SM_D_GC_INDEX
        STA SM_D_INDEX
        JSR SM_C_SLOT_ADDRESS
        LDA #0
        JSR SM_C_COMMIT_BYTE
                        BNE SM_C_GC_RETURN
        JSR SM_C_INDEX_REC
        LDY #3
        LDA #0
        STA (SM_C_REC),Y
SM_C_GC_NEXT:
        INC SM_D_GC_INDEX
        LDA SM_D_GC_INDEX
        CMP #8
                        BNE SM_C_GC_LOOP
        LDA SM_D_GC_PASS
                        BNE SM_C_GC_DONE
        INC SM_D_GC_PASS
        STZ SM_D_GC_INDEX
                        BRA SM_C_GC_LOOP
SM_C_GC_DONE:
        LDA #0
SM_C_GC_RETURN:
        JMP SM_C_FINISH
SM_C_FORMAT: LDX #7
SM_C_FORMAT_KEY:
        LDA SM_C_REQUEST+24,X
        CMP SM_D_FORMAT_MAGIC,X
                        BNE SM_C_ARG_BAD
        DEX
                        BPL SM_C_FORMAT_KEY
        JSR SM_A_FORMAT_GUARD
                        BNE SM_C_FORMAT_RETURN
        ; Invalidate and verify layout first. Never clear directory under a
        ; still-valid old header. Interrupted format requires explicit retry.
        STZ SM_D_ADDR
        STZ SM_D_ADDR+1
        LDA #0
        JSR SM_C_COMMIT_BYTE
                        BNE SM_C_FORMAT_RETURN
        STZ SM_D_INDEX
SM_C_FORMAT_SLOTS:
        JSR SM_C_SLOT_ADDRESS
        LDA #0
        JSR SM_C_COMMIT_BYTE
                        BNE SM_C_FORMAT_RETURN
        INC SM_D_INDEX
        LDA SM_D_INDEX
        CMP #8
                        BNE SM_C_FORMAT_SLOTS
        LDX #59
SM_C_FORMAT_LAYOUT:
        LDA SM_D_LAYOUT,X
        STA SM_C_BUF,X
        DEX
                        BPL SM_C_FORMAT_LAYOUT
        STZ SM_C_BUF+62
        STZ SM_C_BUF+63
        JSR SM_C_SEAL_HEADER
        STZ SM_D_ADDR
        STZ SM_D_ADDR+1
        JSR SM_C_WRITE_VERIFY
                        BNE SM_C_FORMAT_RETURN
        LDA #$A5
        JSR SM_C_COMMIT_BYTE
SM_C_FORMAT_RETURN:
        JMP SM_C_FINISH
SM_C_CRC_INIT:
        LDA #$FF
        STA SM_D_CRC
        STA SM_D_CRC+1
        RTS
SM_C_CRC_BYTE:
        EOR SM_D_CRC+1
        STA SM_D_CRC+1
        LDX #8
SM_C_CRC_BIT:
        ASL SM_D_CRC
        ROL SM_D_CRC+1
                        BCC SM_C_CRC_NEXT
        LDA SM_D_CRC
        EOR #$21
        STA SM_D_CRC
        LDA SM_D_CRC+1
        EOR #$10
        STA SM_D_CRC+1
SM_C_CRC_NEXT:
        DEX
                        BNE SM_C_CRC_BIT
        RTS
SM_C_HEADER_CRC:
        JSR SM_C_CRC_INIT
        LDY #0
SM_C_HEADER_CRC_LOOP:
        LDA SM_C_BUF,Y
        JSR SM_C_CRC_BYTE
        INY
        CPY #62
                        BNE SM_C_HEADER_CRC_LOOP
        LDA SM_D_CRC
        ORA SM_D_CRC+1
        RTS
SM_C_SEAL_HEADER:
        JSR SM_C_CRC_INIT
        LDY #0
SM_C_SEAL_LOOP:
        LDA SM_C_BUF,Y
        JSR SM_C_CRC_BYTE
        INY
        CPY #60
                        BNE SM_C_SEAL_LOOP
        LDA SM_D_CRC+1
        STA SM_C_BUF+60
        LDA SM_D_CRC
        STA SM_C_BUF+61
        RTS
SM_C_CONSOLE:
        SEI
        CLD
        LDX #<SM_D_TITLE
        LDY #>SM_D_TITLE
        JSR SM_C_PRINT
        JSR SM_C_HELP
SM_C_PROMPT: LDX #<SM_D_PROMPT_TEXT
        LDY #>SM_D_PROMPT_TEXT
        JSR SM_C_PRINT
        JSR B29_LINE_2
                        BCC SM_C_PROMPT
        LDX #31
SM_C_REQUEST_CLEAR:
        STZ SM_C_REQUEST,X
        DEX
                        BPL SM_C_REQUEST_CLEAR
        LDA SM_C_LINE+1
                        BEQ SM_C_CON_COMMAND
        LDA SM_C_LINE
        CMP #'S'
                        BEQ SM_C_CON_COMMAND
        CMP #'R'
                        BEQ SM_C_CON_COMMAND
        CMP #'G'
                        BEQ SM_C_CON_COMMAND
        CMP #'D'
                        BNE SM_C_CON_BAD
SM_C_CON_COMMAND:
        LDA SM_C_LINE
        CMP #'!'
        BNE SW_SM_COMMAND
        JMP SW_CONTROLS
SW_SM_COMMAND:
        LDA SM_C_LINE
        CMP #'Q'
                        BEQ SM_C_QUIT
        CMP #'?'
                        BEQ SM_C_CON_HELP
        CMP #'T'
                        BEQ SM_C_TABLE
        CMP #'C'
                        BEQ SM_C_CON_RECLAIM
        CMP #'F'
                        BEQ SM_C_CON_FORMAT
        CMP #'S'
                        BEQ SM_C_CON_SAVE
        CMP #'R'
                        BEQ SM_C_CON_RESTORE
        CMP #'G'
                        BEQ SM_C_CON_RUN
        CMP #'D'
                        BNE SM_C_CON_BAD
        LDA #4
                        JMP SM_C_CON_NAMED
SM_C_CON_RUN:LDA #3
                        JMP SM_C_CON_NAMED
SM_C_CON_RESTORE:
        LDA #2
SM_C_CON_NAMED:
        STA SM_C_REQUEST
        JSR SM_C_PARSE_NAME
                        BCC SM_C_CON_BAD
        LDA SM_C_LINE,X
                        BNE SM_C_CON_BAD
                        JMP SM_C_CON_DO
SM_C_CON_SAVE:
        LDA #1
        STA SM_C_REQUEST
        JSR SM_C_PARSE_NAME
                        BCC SM_C_CON_BAD
        LDY #2
SM_C_PARSE_WORDS:
        LDA SM_C_LINE,X
        CMP #' '
                        BNE SM_C_CON_BAD
        INX
        JSR SM_C_PARSE_HEX
                        BCC SM_C_CON_BAD
        LDA SM_D_WORD
        STA SM_C_REQUEST,Y
        INY
        LDA SM_D_WORD+1
        STA SM_C_REQUEST,Y
        INY
        CPY #8
                        BNE SM_C_PARSE_WORDS
        LDA SM_C_LINE,X
                        BNE SM_C_CON_BAD
SM_C_CON_DO: JSR SM_C_OPERATION
SM_C_CON_RESULT:
        CMP #0
        BEQ B29_SRAM_OK
        JSR B29_ERROR_HOOK
B29_SRAM_OK:
        PHA
        LDX #<SM_D_RESULT_TEXT
        LDY #>SM_D_RESULT_TEXT
        JSR SM_C_PRINT
        PLA
        JSR SM_C_HEX
        JSR SM_C_NL
        JMP SM_C_PROMPT
SM_C_CON_BAD:LDA #$44
                        JMP SM_C_CON_RESULT
SM_C_CON_RECLAIM:
        LDA #5
        STA SM_C_REQUEST
                        JMP SM_C_CON_DO
SM_C_CON_FORMAT:
        LDX #<SM_D_CONFIRM_TEXT
        LDY #>SM_D_CONFIRM_TEXT
        JSR SM_C_PRINT
        JSR SM_C_READLINE
                        BCC SM_C_PROMPT
        LDX #11
SM_C_CONFIRM_CHECK:
        LDA SM_C_LINE,X
        CMP SM_D_CONFIRM_MAGIC,X
                        BNE SM_C_CON_BAD
        DEX
                        BPL SM_C_CONFIRM_CHECK
        LDX #7
SM_C_CON_FORMAT_KEY:
        LDA SM_D_FORMAT_MAGIC,X
        STA SM_C_REQUEST+24,X
        DEX
                        BPL SM_C_CON_FORMAT_KEY
        LDA #6
        STA SM_C_REQUEST
                        JMP SM_C_CON_DO
SM_C_CON_HELP:
        JSR SM_C_HELP
        JMP SM_C_PROMPT
SM_C_QUIT:   JMP SW_SUB_Q
SM_C_HELP:   LDX #<SM_D_HELP_TEXT
        LDY #>SM_D_HELP_TEXT
        JMP SM_C_PRINT
SM_C_TABLE:  JSR SM_C_OPERATION
                        BNE SM_C_CON_RESULT
        STZ SM_D_GC_INDEX
SM_C_TABLE_LOOP:
        LDA SM_D_GC_INDEX
        STA SM_D_INDEX
        JSR SM_C_INDEX_REC
        LDY #3
        LDA (SM_C_REC),Y
        CMP #$A5
                        BNE SM_C_TABLE_NEXT
        LDY #15
        LDA (SM_C_REC),Y
        CMP #1
                        BNE SM_C_TABLE_NEXT
        LDY #16
        LDX #0
SM_C_TABLE_NAME_COPY:
        LDA (SM_C_REC),Y
        STA SM_C_REQUEST+8,X
        INY
        INX
        CPX #16
                        BNE SM_C_TABLE_NAME_COPY
        JSR SM_C_FIND_NAME
                        BNE SM_C_CON_RESULT
        LDA SM_D_BEST
        CMP SM_D_GC_INDEX
                        BNE SM_C_TABLE_NEXT
        JSR SM_C_BEST_REC
        LDY #16
SM_C_TABLE_NAME:
        LDA (SM_C_REC),Y
                        BEQ SM_C_TABLE_FIELDS
        JSR SM_C_PUTC
        INY
        CPY #32
                        BNE SM_C_TABLE_NAME
SM_C_TABLE_FIELDS:
        LDA #' '
        JSR SM_C_PUTC
        LDY #5
        LDA (SM_C_REC),Y
        JSR SM_C_HEX
        DEY
        LDA (SM_C_REC),Y
        JSR SM_C_HEX
        LDA #' '
        JSR SM_C_PUTC
        LDY #7
        LDA (SM_C_REC),Y
        JSR SM_C_HEX
        DEY
        LDA (SM_C_REC),Y
        JSR SM_C_HEX
        JSR SM_C_NL
SM_C_TABLE_NEXT:
        INC SM_D_GC_INDEX
        LDA SM_D_GC_INDEX
        CMP #8
                        BNE SM_C_TABLE_LOOP
        LDX #<SM_D_FREE_TEXT
        LDY #>SM_D_FREE_TEXT
        JSR SM_C_PRINT
        JSR SM_A_FREE_PAGES
        JSR SM_C_HEX
        LDA #0
        JSR SM_C_HEX
        JSR SM_C_NL
        JMP SM_C_PROMPT
SM_C_PARSE_NAME:
        LDX #1
        LDA SM_C_LINE,X
        CMP #' '
                        BNE SM_C_PARSE_FAIL
        INX
        LDY #0
SM_C_PARSE_NAME_LOOP:
        LDA SM_C_LINE,X
                        BEQ SM_C_PARSE_NAME_DONE
        CMP #' '
                        BEQ SM_C_PARSE_NAME_DONE
        CPY #16
                        BCS SM_C_PARSE_FAIL
        STA SM_C_REQUEST+8,Y
        INY
        INX
                        BRA SM_C_PARSE_NAME_LOOP
SM_C_PARSE_NAME_DONE:
        CPY #0
                        BEQ SM_C_PARSE_FAIL
        SEC
        RTS
SM_C_PARSE_HEX:
        STZ SM_D_WORD
        STZ SM_D_WORD+1
        LDA #4
        STA SM_D_DIGITS
SM_C_PARSE_HEX_LOOP:
        LDA SM_C_LINE,X
        CMP #'0'
                        BCC SM_C_PARSE_FAIL
        CMP #'9'+1
                        BCC SM_C_PARSE_DIGIT
        CMP #'A'
                        BCC SM_C_PARSE_FAIL
        CMP #'F'+1
                        BCS SM_C_PARSE_FAIL
        SEC
        SBC #7
SM_C_PARSE_DIGIT:
        SEC
        SBC #'0'
        PHX
        LDX #4
SM_C_PARSE_SHIFT:
        ASL SM_D_WORD
        ROL SM_D_WORD+1
        DEX
                        BNE SM_C_PARSE_SHIFT
        PLX
        ORA SM_D_WORD
        STA SM_D_WORD
        INX
        DEC SM_D_DIGITS
                        BNE SM_C_PARSE_HEX_LOOP
        SEC
        RTS
SM_C_PARSE_FAIL:
        CLC
        RTS
SM_C_READLINE:
        STZ SM_D_LINE_LENGTH
        STZ SM_D_OVERFLOW
SM_C_LINE_WAIT:
        JSR SM_C_GETC
        CMP #3
                        BEQ SM_C_LINE_CANCEL
        CMP #$1B
                        BEQ SM_C_LINE_CANCEL
        CMP #10
                        BEQ SM_C_LINE_WAIT
        CMP #13
                        BEQ SM_C_LINE_DONE
        CMP #8
                        BEQ SM_C_LINE_BACK
        CMP #$7F
                        BEQ SM_C_LINE_BACK
        CMP #$20
                        BCC SM_C_LINE_WAIT
        CMP #'a'
                        BCC SM_C_LINE_CHAR
        CMP #'z'+1
                        BCS SM_C_LINE_CHAR
        AND #$DF
SM_C_LINE_CHAR:
        LDX SM_D_LINE_LENGTH
        CPX #39
                        BCS SM_C_LINE_FULL
        STA SM_C_LINE,X
        INC SM_D_LINE_LENGTH
        JSR SM_C_PUTC
                        JMP SM_C_LINE_WAIT
SM_C_LINE_FULL:
        LDA #1
        STA SM_D_OVERFLOW
                        JMP SM_C_LINE_WAIT
SM_C_LINE_BACK:
        LDA SM_D_LINE_LENGTH
                        BEQ SM_C_LINE_WAIT
        DEC SM_D_LINE_LENGTH
        LDA #8
        JSR SM_C_PUTC
        LDA #' '
        JSR SM_C_PUTC
        LDA #8
        JSR SM_C_PUTC
                        JMP SM_C_LINE_WAIT
SM_C_LINE_DONE:
        LDX SM_D_LINE_LENGTH
        STZ SM_C_LINE,X
        JSR SM_C_NL
        LDA SM_D_OVERFLOW
                        BNE SM_C_LINE_CANCEL
        SEC
        RTS
SM_C_LINE_CANCEL: JSR B29_CANCEL_HOOK

        JSR SM_C_NL
        CLC
        RTS
SM_C_PRINT:  STX SM_C_TEXT
        STY SM_C_TEXT+1
        LDY #0
SM_C_PRINT_LOOP:
        LDA (SM_C_TEXT),Y
                        BEQ SM_C_PRINT_DONE
        JSR SM_C_PUTC
        INY
                        BRA SM_C_PRINT_LOOP
SM_C_PRINT_DONE:
        RTS
SM_C_APP_END:

; SRAM 1.1 layout reader: primary only. WORK repairs interrupted primary.
SM_A_SELECT_LAYOUT:
        JSR SM_C_HEADER_CRC
                        BNE SM_A_LAYOUT_BAD
        LDA SM_S_BUF
        CMP #'S'
                        BNE SM_A_LAYOUT_BAD
        LDA SM_S_BUF+1
        CMP #'S'
                        BNE SM_A_LAYOUT_BAD
        LDA SM_S_BUF+3
        CMP #8
                        BNE SM_A_LAYOUT_BAD
        LDA SM_S_BUF+4
        CMP #8
                        BNE SM_A_LAYOUT_BAD
        LDA SM_S_BUF+2
        CMP #1
                        BEQ SM_A_SELECT_LEGACY
        CMP #2
                        BNE SM_A_LAYOUT_BAD
        LDA SM_S_BUF+7
        ORA SM_S_BUF+62
                        BNE SM_A_LAYOUT_BAD
        LDX #59
SM_A_LAYOUT_RESERVED:
        LDA SM_S_BUF,X
                        BNE SM_A_LAYOUT_BAD
        DEX
        CPX #11
                        BNE SM_A_LAYOUT_RESERVED
        LDA SM_S_BUF+8
        ORA SM_S_BUF+9
        ORA SM_S_BUF+10
        ORA SM_S_BUF+11
                        BEQ SM_A_LAYOUT_BAD
        LDA SM_S_BUF+5
        AND #$3F
                        BNE SM_A_LAYOUT_BAD
        LDA SM_S_BUF+6
                        BEQ SM_A_SELECT_SMALL
        CMP #1
                        BNE SM_A_LAYOUT_BAD
        LDA SM_S_BUF+5
                        BNE SM_A_LAYOUT_BAD
                        JMP SM_A_SELECT_OK
SM_A_SELECT_SMALL:
        LDA SM_S_BUF+5
                        BEQ SM_A_LAYOUT_BAD
SM_A_SELECT_OK:
        LDA SM_S_BUF+5
        STA SM_D_LIMIT
        LDA #0
        RTS
SM_A_SELECT_LEGACY:
        LDX #59
SM_A_LEGACY_COMPARE:
        LDA SM_S_BUF,X
        CMP SM_D_LAYOUT,X
                        BNE SM_A_LAYOUT_BAD
        DEX
                        BPL SM_A_LEGACY_COMPARE
                        JMP SM_A_SELECT_OK
SM_A_LAYOUT_BAD:
        LDA #$41
        RTS
SM_A_EXTENT_LIMIT:
                        BCC SM_A_EXTENT_NORMAL
                        BNE SM_A_LAYOUT_BAD
        LDX SM_D_LIMIT
                        BNE SM_A_LAYOUT_BAD
                        BRA SM_A_EXTENT_OK
SM_A_EXTENT_NORMAL:
        LDX SM_D_LIMIT
                        BEQ SM_A_EXTENT_OK
        CMP SM_D_LIMIT
                        BCC SM_A_EXTENT_OK
                        BNE SM_A_LAYOUT_BAD
SM_A_EXTENT_OK:
        LDA #0
        RTS
SM_A_FREE_PAGES:
        LDA SM_D_LIMIT
        SEC
        SBC #8
        SEC
        SBC SM_D_USED
        RTS
SM_A_FORMAT_GUARD:
        STZ SM_D_ADDR
        STZ SM_D_ADDR+1
        JSR SM_C_READ_BLOCK
                        BNE SM_A_GUARD_RETURN
        JSR SM_A_CHECK_V2
                        BNE SM_A_GUARD_RETURN
        LDA #$40
        STA SM_D_ADDR
        LDA #2
        STA SM_D_ADDR+1
        JSR SM_C_READ_BLOCK
                        BNE SM_A_GUARD_RETURN
SM_A_CHECK_V2:
        LDA SM_S_BUF+2
        CMP #2
                        BNE SM_A_GUARD_OK
        LDA SM_S_BUF+63
        CMP #$A5
                        BNE SM_A_GUARD_OK
        LDA SM_S_BUF
        CMP #'S'
                        BNE SM_A_GUARD_OK
        LDA SM_S_BUF+1
        CMP #'S'
                        BNE SM_A_GUARD_OK
        LDA #$49
SM_A_GUARD_RETURN:
        RTS
SM_A_GUARD_OK:
        LDA #0
        RTS
SM_A_AUX_END:

; Trusted MAINT streaming hooks. Ordinary SRAM API/console uses zero hooks.
SM_S_PTR EQU $D2
SM_S_BUF EQU $6400
SM_S_SOURCE_BYTE:
        LDA SM_D_RESTORE_TRANSFER_HOOK+1
                        BNE SM_S_STAGED_BYTE
        LDA SM_D_SOURCE_BYTE_HOOK+1
                        BNE SM_S_HOOK_BYTE
        LDA (SM_S_PTR),Y
        RTS
SM_S_STAGED_BYTE:
        LDA SM_S_BUF,Y
        RTS
SM_S_HOOK_BYTE:
        JMP (SM_D_SOURCE_BYTE_HOOK)
SM_S_SAVE_TRANSFER:
        LDA SM_D_SAVE_TRANSFER_HOOK+1
                        BNE SM_S_HOOK_SAVE
        LDA #2
        JMP SM_C_TRANSFER
SM_S_HOOK_SAVE:
        JMP (SM_D_SAVE_TRANSFER_HOOK)
SM_S_RESTORE_TRANSFER:
        LDA SM_D_RESTORE_TRANSFER_HOOK+1
                        BNE SM_S_HOOK_RESTORE
        LDA #1
        JMP SM_C_TRANSFER
SM_S_HOOK_RESTORE:
        JMP (SM_D_RESTORE_TRANSFER_HOOK)
SM_S_COPY_BEGIN:
        LDA SM_D_RESTORE_TRANSFER_HOOK+1
                        BNE SM_S_COPY_RETURN
        INC SM_D_COPYING
SM_S_COPY_RETURN:
        RTS
SM_S_EXT_END:

SM_D_SV_MAGIC DB "SV",1
SM_D_SM_MAGIC DB "SM",1,1
SM_D_MASKS DB 1,2,4,8,16,32,64,128
; SS v1: 8 x 64 directory at 0040; data 0800-FFFF; workspace 10000-1FFDF.
SM_D_LAYOUT DB "SS",1,8,8,0,1,0
        DS 52
SM_D_FORMAT_MAGIC DB "FORMAT!!"
SM_D_CONFIRM_MAGIC DB "FORMAT SRAM",0
SM_D_TITLE DB "SRAM 1.4 / BASE1 PR05 gSW_GENERATION_TEXT",13,10,0
SM_D_PROMPT_TEXT DB "SRAM> ",0
SM_D_HELP_TEXT DB "S name start end entry; R/G/D name; T C F Q",13,10,0
SM_D_CONFIRM_TEXT DB "Type FORMAT SRAM: ",0
SM_D_RESULT_TEXT DB "SRAM: ",0
SM_D_FREE_TEXT DB "Free bytes: $",0
SM_D_ADDR EQU $67C7
SM_D_BP EQU $67C9
SM_D_LEFT EQU $67CB
SM_D_LOAD EQU $67CD
SM_D_LENGTH EQU $67CF
SM_D_END_ADDR EQU $67D1
SM_D_ENTRY EQU $67D3
SM_D_CRC EQU $67D5
SM_D_SEQUENCE EQU $67D7
SM_D_BEST_SEQ EQU $67D9
SM_D_WORD EQU $67DB
SM_D_COUNT EQU $67DD
SM_D_STATUS EQU $67DE
SM_D_COPYING EQU $67DF
SM_D_INDEX EQU $67E0
SM_D_FREE_SLOT EQU $67E1
SM_D_BEST EQU $67E2
SM_D_USED EQU $67E3
SM_D_PAGE EQU $67E4
SM_D_PAGES EQU $67E5
SM_D_MASK EQU $67E6
SM_D_RUN_LENGTH EQU $67E7
SM_D_FIRST_PAGE EQU $67E8
SM_D_PAD EQU $67E9
SM_D_GC_INDEX EQU $67EA
SM_D_GC_PASS EQU $67EB
SM_D_DIGITS EQU $67EC
SM_D_LINE_LENGTH EQU $67ED
SM_D_OVERFLOW EQU $67EE
SM_D_AMBIG EQU $67EF
SM_D_LIMIT EQU $67F0
SM_D_SOURCE_BYTE_HOOK EQU $67F1
SM_D_SAVE_TRANSFER_HOOK EQU $67F3
SM_D_RESTORE_TRANSFER_HOOK EQU $67F5
SM_D_DATA_END:
WK_ENTRY:  JSR WK_SAVE_WINDOW
        JSR WK_CLEAR_STATE
        JMP WK_CONSOLE
WK_SAVE_WINDOW:
        PHA
        PHX
        LDX #63
WK_SAVE_WINDOW_LOOP:
        LDA $6400,X
        STA $6A40,X
        DEX
        BPL WK_SAVE_WINDOW_LOOP
        PLX
        PLA
        RTS
WK_RESTORE_WINDOW:
        PHA
        PHX
        LDX #63
WK_RESTORE_WINDOW_LOOP:
        LDA $6A40,X
        STA $6400,X
        DEX
        BPL WK_RESTORE_WINDOW_LOOP
        PLX
        PLA
        RTS
WK_CLEAR_STATE:
        PHX
        LDX #0
WK_CLEAR_LOOP:
        STZ $6800,X
        STZ $6900,X
        INX
        BNE WK_CLEAR_LOOP
        LDX #30
WK_CLEAR_TAIL:
        STZ $6A00,X
        DEX
        BPL WK_CLEAR_TAIL
        PLX
        RTS
; Optional application library, not additional resident RAM. W65C02S/816E.
WK_P EQU $D0
WK_Q EQU $D2
WK_C EQU $D4
WK_R EQU $6650
WK_RESET_LATCH EQU $66AF
WK_MANAGED EQU $66AE
WK_PUTC EQU $7E6D
WK_GETC EQU $7E70
WK_HEX EQU $7E7C
WK_NL EQU $7E7F
WK_START:  JMP WK_CONSOLE
        BRA WK_API
        DB "WK",1,2
WK_API:    JSR WK_SAVE_WINDOW
        JSR WK_CLEAR_STATE
        SEI
        CLD
        STA WK_C
        STX WK_C+1
        LDA #32
        STA WK_N
        JSR WK_CPU_RANGE
                        BNE WK_API_RETURN
        LDY #31
WK_COPY_REQUEST:
        LDA (WK_C),Y
        STA WK_REQ,Y
        DEY
                        BPL WK_COPY_REQUEST
        JSR WK_OPERATION
        PHA
        LDY #31
WK_COPY_RESULT:
        LDA WK_REQ,Y
        STA (WK_C),Y
        DEY
                        BPL WK_COPY_RESULT
        PLA
WK_API_RETURN:
        JSR WK_RESTORE_WINDOW
        CMP #0
                        BNE WK_API_ERROR
        SEC
        RTS
WK_API_ERROR:
        CLC
        RTS
WK_OPERATION:
        STZ WK_CHECKING
        JSR WK_DISCOVER
                        BNE WK_OP_RETURN
        LDA WK_REQ+1
                        BNE WK_BAD_ARG
        LDA WK_REQ
        CMP #9
                        BCS WK_BAD_ARG
        CMP #6
                        BEQ WK_FORMAT
        CMP #7
                        BEQ WK_UPGRADE
        JSR WK_LOAD_LAYOUT
                        BNE WK_OP_RETURN
        LDA WK_REQ
                        BEQ WK_QUERY
        LDA WK_LEGACY
                        BNE WK_NEED_UPGRADE
        LDA WK_REQ
        CMP #8
                        BEQ WK_REPAIR
        JSR WK_SESSION_LOAD
                        BNE WK_OP_RETURN
        LDA WK_RESET_LATCH
                        BNE WK_SESSION_READY
        JSR WK_NEW_EPOCH
                        BNE WK_OP_RETURN
WK_SESSION_READY:
        JSR WK_LOAD_CLAIMS
                        BNE WK_OP_RETURN
        JSR WK_PROGRAM_CHECK
                        BNE WK_OP_RETURN
        LDA WK_REQ
        CMP #5
                        BEQ WK_RESIZE
        LDA WK_REQ+2
        ORA WK_REQ+3
                        BEQ WK_BAD_ARG
        LDA WK_REQ
        CMP #1
                        BEQ WK_CLAIM
        JSR WK_HANDLE
                        BNE WK_OP_RETURN
        LDA WK_REQ
        CMP #2
                        BEQ WK_RELEASE
        JMP WK_IO
WK_OP_RETURN:
        RTS
WK_BAD_ARG:LDA #$44
        RTS
WK_BAD_META:
        LDA #$41
        RTS
WK_NEED_UPGRADE:
        LDA #$49
        RTS
WK_STALE:  LDA #$4B
        RTS
WK_FULL:   LDA #$43
        RTS
WK_VERIFY_BAD:
        LDA #$45
        RTS
WK_EXHAUSTED:
        LDA #$48
        RTS
WK_DISCOVER:
        STZ WK_N
        LDA #0
        JMP WK_TRANSFER
WK_BUF_PTR:
        LDA #<WK_BUF
        STA WK_BP
        LDA #>WK_BUF
        STA WK_BP+1
        RTS
WK_TRANSFER:
        PHA
        LDX #15
WK_REQUEST_ZERO:
        STZ WK_R,X
        DEX
                        BPL WK_REQUEST_ZERO
        LDX #2
WK_REQUEST_ADDR:
        LDA WK_ADDR,X
        STA WK_R+2,X
        DEX
                        BPL WK_REQUEST_ADDR
        LDA WK_BP
        STA WK_R+5
        LDA WK_BP+1
        STA WK_R+6
        LDA WK_N
        STA WK_R+7
        PLA
        STA WK_R
        CMP #2
                        BNE WK_TRAN_READ
        STZ WK_MANAGED
        JSR SW_TRANSFER
        PHA
        LDA #1
        STA WK_MANAGED
        PLA
                        BRA WK_TRAN_RESULT
WK_TRAN_READ:
        JSR SW_TRANSFER
WK_TRAN_RESULT:
        CMP #0
                        BNE WK_TRAN_RETURN
        LDA WK_R
                        BEQ WK_TRAN_RETURN
        LDA WK_R+9
        CMP WK_N
                        BNE WK_TRAN_SHORT
        LDA #0
WK_TRAN_RETURN:
        RTS
WK_TRAN_SHORT:
        LDA #7
        RTS
WK_READ64: LDA #64
                        BRA WK_READ_N
WK_READ32: LDA #32
WK_READ_N: STA WK_N
        JSR WK_BUF_PTR
        LDA #1
        JMP WK_TRANSFER
WK_WRITE_VERIFY:
        JSR WK_BUF_PTR
        LDX WK_N
        DEX
WK_EXPECT_COPY:
        LDA WK_BUF,X
        STA WK_EXPECT,X
        DEX
                        BPL WK_EXPECT_COPY
        LDA #2
        JSR WK_TRANSFER
                        BNE WK_WRITE_RETURN
        LDA #1
        JSR WK_TRANSFER
                        BNE WK_WRITE_RETURN
        LDX WK_N
        DEX
WK_EXPECT_CHECK:
        LDA WK_BUF,X
        CMP WK_EXPECT,X
                        BNE WK_VERIFY_BAD
        DEX
                        BPL WK_EXPECT_CHECK
        LDA #0
WK_WRITE_RETURN:
        RTS
; Publish a 32/64-byte packet. Invalidate/verify old final marker first.
WK_PUBLISH:
        LDA WK_N
        STA WK_PACKET_N
        LDA #0
        JSR WK_MARKER
                        BNE WK_PUB_RETURN
        LDX WK_PACKET_N
        DEX
WK_PUB_RESTORE:
        LDA WK_EXPECT_PACKET,X
        STA WK_BUF,X
        DEX
                        BPL WK_PUB_RESTORE
        LDA WK_PACKET_N
        STA WK_N
        JSR WK_WRITE_VERIFY
                        BNE WK_PUB_RETURN
        LDA #$A5
        JSR WK_MARKER
WK_PUB_RETURN:
        RTS
WK_SAVE_PACKET:
        LDX WK_N
        DEX
WK_PACKET_COPY:
        LDA WK_BUF,X
        STA WK_EXPECT_PACKET,X
        DEX
                        BPL WK_PACKET_COPY
        RTS
WK_MARKER:
        PHA
        LDX #2
WK_MARK_SAVE:
        LDA WK_ADDR,X
        STA WK_SAVE_ADDR,X
        DEX
                        BPL WK_MARK_SAVE
        LDA WK_PACKET_N
        DEC A
        CLC
        ADC WK_ADDR
        STA WK_ADDR
                        BCC WK_MARK_ADDR
        INC WK_ADDR+1
                        BNE WK_MARK_ADDR
        INC WK_ADDR+2
WK_MARK_ADDR:
        PLA
        STA WK_BUF
        LDA #1
        STA WK_N
        JSR WK_WRITE_VERIFY
        PHA
        LDX #2
WK_MARK_RESTORE:
        LDA WK_SAVE_ADDR,X
        STA WK_ADDR,X
        DEX
                        BPL WK_MARK_RESTORE
        PLA
        CMP #0
        RTS
WK_CRC_INIT:
        LDA #$FF
        STA WK_CRC
        STA WK_CRC+1
        RTS
WK_CRC_BYTE:
        EOR WK_CRC+1
        STA WK_CRC+1
        LDX #8
WK_CRC_BIT:
        ASL WK_CRC
        ROL WK_CRC+1
                        BCC WK_CRC_NEXT
        LDA WK_CRC
        EOR #$21
        STA WK_CRC
        LDA WK_CRC+1
        EOR #$10
        STA WK_CRC+1
WK_CRC_NEXT:
        DEX
                        BNE WK_CRC_BIT
        RTS
WK_HEADER_CRC:
        LDA WK_N
        SEC
        SBC #2
                        BRA WK_CRC_BUFFER
WK_SEAL:   LDA WK_N
        SEC
        SBC #4
        JSR WK_CRC_BUFFER
        LDA WK_CRC+1
        STA WK_BUF,Y
        INY
        LDA WK_CRC
        STA WK_BUF,Y
        RTS
WK_CRC_BUFFER:
        STA WK_CRC_N
        JSR WK_CRC_INIT
        LDY #0
WK_CRC_LOOP:
        LDA WK_BUF,Y
        JSR WK_CRC_BYTE
        INY
        CPY WK_CRC_N
                        BNE WK_CRC_LOOP
        LDA WK_CRC
        ORA WK_CRC+1
        RTS
WK_ZERO_BUF:
        LDX #63
WK_ZERO_LOOP:
        STZ WK_BUF,X
        DEX
                        BPL WK_ZERO_LOOP
        RTS
WK_ZERO_ADDR:
        STZ WK_ADDR
        STZ WK_ADDR+1
        STZ WK_ADDR+2
        RTS
WK_LOAD_LAYOUT:
        STZ WK_FALLBACK
        JSR WK_ZERO_ADDR
        JSR WK_READ64
                        BNE WK_LAYOUT_RETURN
        LDA WK_BUF+63
        CMP #$A5
                        BEQ WK_PRIMARY_FOUND
        LDA #$40
        STA WK_ADDR
        LDA #2
        STA WK_ADDR+1
        JSR WK_READ64
                        BNE WK_LAYOUT_RETURN
        INC WK_FALLBACK
WK_PRIMARY_FOUND:
        LDA WK_BUF+63
        CMP #$A5
                        BNE WK_UNFORMATTED
        JSR WK_HEADER_CRC
                        BNE WK_BAD_META
        LDA WK_BUF+7
        ORA WK_BUF+62
                        BNE WK_BAD_META
        LDX #59
WK_LAYOUT_RESERVED:
        LDA WK_BUF,X
                        BNE WK_BAD_META
        DEX
        CPX #11
                        BNE WK_LAYOUT_RESERVED
        LDA WK_BUF
        CMP #'S'
                        BNE WK_BAD_META
        LDA WK_BUF+1
        CMP #'S'
                        BNE WK_BAD_META
        LDA WK_BUF+3
        CMP #8
                        BNE WK_BAD_META
        LDA WK_BUF+4
        CMP #8
                        BNE WK_BAD_META
        LDA WK_BUF+2
        CMP #1
                        BEQ WK_LEGACY_LAYOUT
        CMP #2
                        BNE WK_BAD_META
        STZ WK_LEGACY
        LDA WK_BUF+8
        ORA WK_BUF+9
        ORA WK_BUF+10
        ORA WK_BUF+11
                        BEQ WK_BAD_META
                        BRA WK_LAYOUT_LIMIT
WK_LEGACY_LAYOUT:
        LDA WK_BUF+8
        ORA WK_BUF+9
        ORA WK_BUF+10
        ORA WK_BUF+11
                        BNE WK_BAD_META
        LDA WK_FALLBACK
                        BNE WK_BAD_META
        LDA #1
        STA WK_LEGACY
        LDA WK_BUF+5
                        BNE WK_BAD_META
        LDA WK_BUF+6
        CMP #1
                        BNE WK_BAD_META
WK_LAYOUT_LIMIT:
        LDA WK_BUF+5
        AND #$3F
                        BNE WK_BAD_META
        LDA WK_BUF+6
                        BEQ WK_LIMIT_SMALL
        CMP #1
                        BNE WK_BAD_META
        LDA WK_BUF+5
                        BNE WK_BAD_META
        LDA #4
                        BRA WK_LIMIT_SET
WK_LIMIT_SMALL:
        LDA WK_BUF+5
                        BEQ WK_BAD_META
        LSR A
        LSR A
        LSR A
        LSR A
        LSR A
        LSR A
WK_LIMIT_SET:
        STA WK_UNITS
        LDX #63
WK_LAYOUT_COPY:
        LDA WK_BUF,X
        STA WK_LAYOUT,X
        DEX
                        BPL WK_LAYOUT_COPY
        LDA #0
WK_LAYOUT_RETURN:
        RTS
WK_UNFORMATTED:
        LDA #$40
        RTS
WK_QUERY:  STZ WK_REQ+12
        LDA WK_LAYOUT+5
        STA WK_REQ+13
        LDA WK_LAYOUT+6
        STA WK_REQ+14
        LDA #$E0
        STA WK_REQ+18
        SEC
        LDA #$FF
        SBC WK_LAYOUT+5
        STA WK_REQ+19
        LDA #1
        SBC WK_LAYOUT+6
        STA WK_REQ+20
        LDA WK_UNITS
        STA WK_REQ+21
        LDA WK_LEGACY
        STA WK_REQ+22
        LDA WK_FALLBACK
        STA WK_REQ+23
        LDA #0
        RTS
WK_SESSION_LOAD:
        STZ WK_SESSION_VALID
        LDA #$80
        STA WK_ADDR
        LDA #2
        STA WK_ADDR+1
        STZ WK_ADDR+2
WK_SESSION_SCAN:
        JSR WK_READ64
                        BNE WK_SESSION_RETURN
        LDA WK_BUF+63
        CMP #$A5
                        BNE WK_SESSION_NEXT
        JSR WK_HEADER_CRC
                        BNE WK_BAD_META
        LDX #2
WK_SESSION_MAGIC:
        LDA WK_BUF,X
        CMP WK_WS_MAGIC,X
                        BNE WK_BAD_META
        DEX
                        BPL WK_SESSION_MAGIC
        LDA WK_BUF+3
        ORA WK_BUF+62
                        BNE WK_BAD_META
        LDX #59
WK_SESSION_RESERVED:
        LDA WK_BUF,X
                        BNE WK_BAD_META
        DEX
        CPX #13
                        BNE WK_SESSION_RESERVED
        LDA WK_BUF+4
        ORA WK_BUF+5
        ORA WK_BUF+6
        ORA WK_BUF+7
                        BEQ WK_BAD_META
        LDA WK_BUF+8
        ORA WK_BUF+9
        ORA WK_BUF+10
        ORA WK_BUF+11
                        BEQ WK_BAD_META
        LDA WK_SESSION_VALID
                        BEQ WK_SESSION_SELECT
        LDX #3
WK_SESSION_COMPARE:
        LDA WK_BUF+4,X
        CMP WK_SESSION+4,X
                        BCC WK_SESSION_NEXT
                        BNE WK_SESSION_SELECT
        DEX
                        BPL WK_SESSION_COMPARE
        JMP WK_BAD_META
WK_SESSION_SELECT:
        INC WK_SESSION_VALID
        LDA WK_ADDR
        STA WK_SESSION_ADDR
        LDX #63
WK_SESSION_COPY:
        LDA WK_BUF,X
        STA WK_SESSION,X
        DEX
                        BPL WK_SESSION_COPY
WK_SESSION_NEXT:
        LDA WK_ADDR
        CMP #$C0
                        BEQ WK_SESSION_END
        LDA #$C0
        STA WK_ADDR
                        JMP WK_SESSION_SCAN
WK_SESSION_END:
        LDA WK_SESSION_VALID
                        BEQ WK_BAD_META
        LDA #0
WK_SESSION_RETURN:
        RTS
WK_INC_REVISION:
        LDX #0
WK_REV_INCREMENT:
        INC WK_SESSION+4,X
                        BNE WK_REV_OK
        INX
        CPX #4
                        BNE WK_REV_INCREMENT
        JMP WK_EXHAUSTED
WK_REV_OK: LDA #0
        RTS
WK_NEW_EPOCH:
        LDX #0
WK_EPOCH_INCREMENT:
        INC WK_SESSION+8,X
                        BNE WK_EPOCH_OK
        INX
        CPX #4
                        BNE WK_EPOCH_INCREMENT
        JMP WK_EXHAUSTED
WK_EPOCH_OK:
        STZ WK_SESSION+12
        STZ WK_SESSION+13
        JSR WK_SESSION_COMMIT
                        BNE WK_EPOCH_RETURN
        LDA #1
        STA WK_RESET_LATCH
        LDA #0
WK_EPOCH_RETURN:
        RTS
WK_SESSION_COMMIT:
        JSR WK_INC_REVISION
                        BNE WK_EPOCH_RETURN
        LDX #63
WK_SESSION_PREP:
        LDA WK_SESSION,X
        STA WK_BUF,X
        DEX
                        BPL WK_SESSION_PREP
        STZ WK_BUF+63
        LDA #64
        STA WK_N
        JSR WK_SEAL
        JSR WK_SAVE_PACKET
        LDA WK_SESSION_ADDR
        EOR #$40
        STA WK_ADDR
        STA WK_SESSION_ADDR
        LDA #2
        STA WK_ADDR+1
        STZ WK_ADDR+2
        JMP WK_PUBLISH
WK_LOAD_CLAIMS:
        LDA #4
        STA WK_FREE_SLOT
        STZ WK_SLOT
WK_CLAIMS_SCAN:
        JSR WK_CLAIM_ADDRESS
        JSR WK_READ32
                        BNE WK_CLAIMS_RETURN
        LDA WK_BUF+31
        CMP #$A5
                        BNE WK_CLAIMS_FREE
        JSR WK_HEADER_CRC
                        BNE WK_BAD_META
        LDX #2
WK_CLAIM_MAGIC:
        LDA WK_BUF,X
        CMP WK_WC_MAGIC,X
                        BNE WK_BAD_META
        DEX
                        BPL WK_CLAIM_MAGIC
        LDA WK_BUF+3
        ORA WK_BUF+15
        ORA WK_BUF+19
        ORA WK_BUF+30
                        BNE WK_BAD_META
        LDX #27
WK_CLAIM_RESERVED:
        LDA WK_BUF,X
                        BNE WK_BAD_META
        DEX
        CPX #19
                        BNE WK_CLAIM_RESERVED
        LDX #3
WK_CLAIM_EPOCH:
        LDA WK_BUF+8,X
        CMP WK_SESSION+8,X
                        BNE WK_CLAIMS_FREE
        DEX
                        BPL WK_CLAIM_EPOCH
        LDA WK_BUF+4
        ORA WK_BUF+5
                        BEQ WK_BAD_META
        LDA WK_BUF+6
        ORA WK_BUF+7
                        BEQ WK_BAD_META
        LDA WK_BUF+12
                        BNE WK_BAD_META
        LDA WK_BUF+16
        ORA WK_BUF+17
        ORA WK_BUF+18
                        BEQ WK_BAD_META
        LDX #2
WK_CLAIM_SPAN:
        LDA WK_BUF+12,X
        STA WK_POS,X
        LDA WK_BUF+16,X
        STA WK_SIZE,X
        DEX
                        BPL WK_CLAIM_SPAN
        JSR WK_SPAN_END
                        BNE WK_BAD_META
        LDA WK_POS+2
        CMP WK_LAYOUT+6
                        BCC WK_BAD_META
                        BNE WK_CLAIMS_CACHE
        LDA WK_POS+1
        CMP WK_LAYOUT+5
                        BCC WK_BAD_META
                        BRA WK_CLAIMS_CACHE
WK_CLAIMS_FREE:
        STZ WK_BUF+31
        LDA WK_SLOT
        STA WK_FREE_SLOT
WK_CLAIMS_CACHE:
        JSR WK_SLOT_POINTER
        LDY #31
WK_CLAIM_CACHE_COPY:
        LDA WK_BUF,Y
        STA (WK_P),Y
        DEY
                        BPL WK_CLAIM_CACHE_COPY
        INC WK_SLOT
        LDA WK_SLOT
        CMP #4
                        BNE WK_CLAIMS_SCAN
        JSR WK_CHECK_OVERLAPS
WK_CLAIMS_RETURN:
        RTS
WK_CHECK_OVERLAPS:
        LDA #1
        STA WK_CHECKING
        STZ WK_CHECK_SLOT
WK_CHECK_OUTER:
        LDA WK_CHECK_SLOT
        STA WK_SLOT
        JSR WK_SLOT_POINTER
        LDY #31
        LDA (WK_P),Y
        CMP #$A5
                        BNE WK_CHECK_NEXT
        LDY #12
        LDX #0
WK_CHECK_START_COPY:
        LDA (WK_P),Y
        STA WK_POS,X
        INY
        INX
        CPX #3
                        BNE WK_CHECK_START_COPY
        LDY #16
        LDX #0
WK_CHECK_SIZE_COPY:
        LDA (WK_P),Y
        STA WK_SIZE,X
        INY
        INX
        CPX #3
                        BNE WK_CHECK_SIZE_COPY
        JSR WK_ALLOC_RESTART
                        BNE WK_CLAIMS_RETURN
WK_CHECK_NEXT:
        INC WK_CHECK_SLOT
        LDA WK_CHECK_SLOT
        CMP #4
                        BNE WK_CHECK_OUTER
        STZ WK_CHECKING
        LDA #0
        RTS
WK_CLAIM_ADDRESS:
        LDA WK_SLOT
        ASL A
        ASL A
        ASL A
        ASL A
        ASL A
        STA WK_ADDR
        LDA #3
        STA WK_ADDR+1
        STZ WK_ADDR+2
        RTS
WK_SLOT_POINTER:
        LDA WK_SLOT
        ASL A
        ASL A
        ASL A
        ASL A
        ASL A
        CLC
        ADC #<WK_CLAIMS
        STA WK_P
        LDA #>WK_CLAIMS
        ADC #0
        STA WK_P+1
        RTS
WK_SPAN_END:
        LDA #3
        STA WK_ARITH_N
        CLC
        LDX #0
WK_SPAN_ADD:
        LDA WK_POS,X
        ADC WK_SIZE,X
        STA WK_END_POS,X
        INX
        DEC WK_ARITH_N
                        BNE WK_SPAN_ADD
                        BCS WK_BAD_ARG
        LDX #2
WK_SPAN_BOUND:
        LDA WK_END_POS,X
        CMP WK_MAX_END,X
                        BCC WK_SPAN_OK
                        BNE WK_BAD_ARG
        DEX
                        BPL WK_SPAN_BOUND
WK_SPAN_OK:LDA #0
        RTS
WK_CLAIM:  LDA WK_FREE_SLOT
        CMP #4
                        BCS WK_FULL
        LDX #2
WK_CLAIM_SIZE:
        LDA WK_REQ+18,X
        STA WK_SIZE,X
        DEX
                        BPL WK_CLAIM_SIZE
        LDA WK_SIZE
        ORA WK_SIZE+1
        ORA WK_SIZE+2
                        BEQ WK_BAD_ARG
        STZ WK_POS
        LDA WK_LAYOUT+5
        STA WK_POS+1
        LDA WK_LAYOUT+6
        STA WK_POS+2
WK_ALLOC_RESTART:
        JSR WK_SPAN_END
                        BNE WK_FULL
        STZ WK_SLOT
WK_ALLOC_SCAN:
        LDA WK_CHECKING
                        BEQ WK_ALLOC_CHECK
        LDA WK_SLOT
        CMP WK_CHECK_SLOT
                        BEQ WK_ALLOC_NEXT
WK_ALLOC_CHECK:
        JSR WK_SLOT_POINTER
        LDY #31
        LDA (WK_P),Y
        CMP #$A5
                        BNE WK_ALLOC_NEXT
        ; candidate end <= claim start: no overlap.
        LDY #14
        LDX #2
WK_ALLOC_BEFORE:
        LDA WK_END_POS,X
        CMP (WK_P),Y
                        BCC WK_ALLOC_NEXT
                        BNE WK_ALLOC_AFTER_START
        DEY
        DEX
                        BPL WK_ALLOC_BEFORE
                        JMP WK_ALLOC_NEXT
WK_ALLOC_AFTER_START:
        ; candidate start >= claim end: no overlap.
        LDY #12
        CLC
        LDX #0
WK_ALLOC_OLD_END:
        LDA (WK_P),Y
        STA WK_OLD_END,X
        INY
        INX
        CPX #3
                        BNE WK_ALLOC_OLD_END
        LDY #16
        LDA #3
        STA WK_ARITH_N
        CLC
        LDX #0
WK_ALLOC_OLD_ADD:
        LDA (WK_P),Y
        ADC WK_OLD_END,X
        STA WK_OLD_END,X
        INY
        INX
        DEC WK_ARITH_N
                        BNE WK_ALLOC_OLD_ADD
        LDX #2
WK_ALLOC_AFTER:
        LDA WK_POS,X
        CMP WK_OLD_END,X
                        BCC WK_ALLOC_COLLISION
                        BNE WK_ALLOC_NEXT
        DEX
                        BPL WK_ALLOC_AFTER
                        JMP WK_ALLOC_NEXT
WK_ALLOC_COLLISION:
        LDA WK_CHECKING
                        BNE WK_BAD_META
        STZ WK_POS
        LDA WK_OLD_END
        CMP #1
        LDA WK_OLD_END+1
        ADC #0
        STA WK_POS+1
        LDA WK_OLD_END+2
        ADC #0
        STA WK_POS+2
                        JMP WK_ALLOC_RESTART
WK_ALLOC_NEXT:
        INC WK_SLOT
        LDA WK_SLOT
        CMP #4
                        BNE WK_ALLOC_SCAN
        LDA WK_CHECKING
                        BEQ WK_ALLOC_PUBLISH
        LDA #0
        RTS
WK_ALLOC_PUBLISH:
        LDA WK_SESSION+12
        AND WK_SESSION+13
        CMP #$FF
                        BEQ WK_EXHAUSTED
        INC WK_SESSION+12
                        BNE WK_CLAIM_TICKET
        INC WK_SESSION+13
WK_CLAIM_TICKET:
        JSR WK_SESSION_COMMIT
                        BNE WK_CLAIMS_RETURN
        JSR WK_ZERO_BUF
        LDX #2
WK_CLAIM_NEW_MAGIC:
        LDA WK_WC_MAGIC,X
        STA WK_BUF,X
        DEX
                        BPL WK_CLAIM_NEW_MAGIC
        LDX #1
WK_CLAIM_OWNER:
        LDA WK_REQ+2,X
        STA WK_BUF+4,X
        LDA WK_SESSION+12,X
        STA WK_BUF+6,X
        DEX
                        BPL WK_CLAIM_OWNER
        LDX #3
WK_CLAIM_NEW_EPOCH:
        LDA WK_SESSION+8,X
        STA WK_BUF+8,X
        STA WK_REQ+6,X
        DEX
                        BPL WK_CLAIM_NEW_EPOCH
        LDX #2
WK_CLAIM_NEW_SPAN:
        LDA WK_POS,X
        STA WK_BUF+12,X
        LDA WK_SIZE,X
        STA WK_BUF+16,X
        STZ WK_REQ+12,X
        DEX
                        BPL WK_CLAIM_NEW_SPAN
        LDA WK_FREE_SLOT
        STA WK_SLOT
        STA WK_REQ+4
        STZ WK_REQ+5
        LDA WK_SESSION+12
        STA WK_REQ+10
        LDA WK_SESSION+13
        STA WK_REQ+11
        LDA #32
        STA WK_N
        JSR WK_SEAL
        JSR WK_SAVE_PACKET
        JSR WK_CLAIM_ADDRESS
        JMP WK_PUBLISH
WK_HANDLE:
        LDA WK_REQ+5
                        BNE WK_STALE
        LDA WK_REQ+4
        CMP #4
                        BCS WK_STALE
        STA WK_SLOT
        JSR WK_SLOT_POINTER
        LDY #31
        LDA (WK_P),Y
        CMP #$A5
                        BNE WK_STALE
        LDY #4
        LDX #2
WK_HANDLE_OWNER:
        LDA (WK_P),Y
        CMP WK_REQ,X
                        BNE WK_STALE
        INY
        INX
        CPX #4
                        BNE WK_HANDLE_OWNER
        LDY #6
        LDX #10
WK_HANDLE_TICKET:
        LDA (WK_P),Y
        CMP WK_REQ,X
                        BNE WK_STALE
        INY
        INX
        CPX #12
                        BNE WK_HANDLE_TICKET
        LDY #8
        LDX #6
WK_HANDLE_EPOCH:
        LDA (WK_P),Y
        CMP WK_REQ,X
                        BNE WK_STALE
        INY
        INX
        CPX #10
                        BNE WK_HANDLE_EPOCH
        LDA #0
        RTS
WK_RELEASE:
        JSR WK_CLAIM_ADDRESS
        LDA #32
        STA WK_PACKET_N
        LDA #0
        JMP WK_MARKER
WK_IO:     LDA WK_REQ+15
                        BEQ WK_BAD_ARG
        CMP #65
                        BCS WK_BAD_ARG
        STA WK_N
        LDA #3
        STA WK_ARITH_N
        CLC
        LDX #0
WK_IO_OFFSET_END:
        LDA WK_REQ+12,X
        ADC WK_N
        STA WK_END_POS,X
        INX
        LDA #0
        STA WK_N
        DEC WK_ARITH_N
                        BNE WK_IO_OFFSET_END
                        BCS WK_BAD_ARG
        LDY #18
        LDX #2
WK_IO_BOUND:
        LDA WK_END_POS,X
        CMP (WK_P),Y
                        BCC WK_IO_ADDRESS
                        BNE WK_BAD_ARG
        DEY
        DEX
                        BPL WK_IO_BOUND
WK_IO_ADDRESS:
        LDY #12
        LDA #3
        STA WK_ARITH_N
        CLC
        LDX #0
WK_IO_ADDRESS_ADD:
        LDA (WK_P),Y
        ADC WK_REQ+12,X
        STA WK_ADDR,X
        INY
        INX
        DEC WK_ARITH_N
                        BNE WK_IO_ADDRESS_ADD
        LDA WK_REQ+15
        STA WK_N
        LDA WK_REQ+16
        STA WK_BP
        LDA WK_REQ+17
        STA WK_BP+1
        LDA WK_BP
        PHA
        LDA WK_BP+1
        PHA
        LDA WK_C
        STA WK_SAVE_C
        LDA WK_C+1
        STA WK_SAVE_C+1
        LDA WK_BP
        STA WK_C
        LDA WK_BP+1
        STA WK_C+1
        JSR WK_CPU_RANGE
        STA WK_ERROR
        PLA
        STA WK_BP+1
        PLA
        STA WK_BP
        LDA WK_SAVE_C
        STA WK_C
        LDA WK_SAVE_C+1
        STA WK_C+1
        LDA WK_ERROR
                        BNE WK_OP_RETURN
        ; READ cannot overwrite the caller's request/result block.
        LDA WK_REQ
        CMP #3
                        BNE WK_IO_TRANSFER
        LDA WK_BP
        CLC
        ADC WK_N
        STA WK_TEMP
        LDA WK_BP+1
        ADC #0
        CMP WK_C+1
                        BCC WK_IO_TRANSFER
                        BNE WK_IO_READ_AFTER
        LDA WK_TEMP
        CMP WK_C
                        BCC WK_IO_TRANSFER
                        BEQ WK_IO_TRANSFER
WK_IO_READ_AFTER:
        LDA WK_C
        CLC
        ADC #32
        STA WK_TEMP
        LDA WK_C+1
        ADC #0
        CMP WK_BP+1
                        BCC WK_IO_TRANSFER
                        BNE WK_BAD_ARG
        LDA WK_TEMP
        CMP WK_BP
                        BCC WK_IO_TRANSFER
                        BNE WK_BAD_ARG
WK_IO_TRANSFER:
        LDA WK_REQ
        CMP #4
                        BNE WK_IO_READ
        LDA WK_BP
        STA WK_Q
        LDA WK_BP+1
        STA WK_Q+1
        LDY #0
WK_IO_STAGE:
        LDA (WK_Q),Y
        STA WK_BUF,Y
        INY
        CPY WK_N
                        BNE WK_IO_STAGE
        JSR WK_WRITE_VERIFY
                        BRA WK_IO_RESULT
WK_IO_READ:
        LDA #1
        JSR WK_TRANSFER
WK_IO_RESULT:
        PHA
        LDA WK_R+9
        STA WK_REQ+22
        LDA WK_R+10
        STA WK_REQ+23
        PLA
        CMP #0
        RTS
WK_CPU_RANGE:
        LDA WK_C+1
        CMP #2
        BCC WK_BAD_ARG
        CLC
        LDA WK_C
        ADC WK_N
        STA WK_TEMP
        LDA WK_C+1
        ADC #0
        BCS WK_BAD_ARG
        CMP #$20
        BCC WK_CPU_OK
        BNE WK_BAD_ARG
        LDA WK_TEMP
        BNE WK_BAD_ARG
WK_CPU_OK:
        LDA #0
        RTS
WK_PROGRAM_CHECK:
        STZ WK_PROG_SLOT
WK_PROG_SCAN:
        LDA WK_PROG_SLOT
        INC A
        LSR A
        LSR A
        STA WK_ADDR+1
        LDA WK_PROG_SLOT
        INC A
        AND #3
        ASL A
        ASL A
        ASL A
        ASL A
        ASL A
        ASL A
        STA WK_ADDR
        STZ WK_ADDR+2
        JSR WK_READ64
                        BNE WK_PROG_RETURN
        LDA WK_BUF+63
        CMP #$A5
                        BNE WK_PROG_NEXT
        JSR WK_HEADER_CRC
                        BNE WK_BAD_META
        LDX #2
WK_PROG_MAGIC:
        LDA WK_BUF,X
        CMP WK_SP_MAGIC,X
                        BNE WK_BAD_META
        DEX
                        BPL WK_PROG_MAGIC
        LDA WK_BUF+15
        CMP #2
                        BEQ WK_PROG_TOMBSTONE
        CMP #1
                        BNE WK_BAD_META
        LDA WK_BUF+6
        ORA WK_BUF+7
                        BEQ WK_BAD_META
        LDA WK_BUF+14
        CMP #8
                        BCC WK_BAD_META
        LDA WK_BUF+6
        CMP #1
        LDA WK_BUF+7
        ADC WK_BUF+14
        STA WK_PAGE_END
        LDA #0
        ADC #0
        STA WK_PAGE_END+1
        CMP WK_LAYOUT+6
                        BCC WK_PROG_NEXT
                        BNE WK_BAD_META
        LDA WK_PAGE_END
        CMP WK_LAYOUT+5
                        BCC WK_PROG_NEXT
                        BEQ WK_PROG_NEXT
        JMP WK_BAD_META
WK_PROG_TOMBSTONE:
        LDA WK_BUF+6
        ORA WK_BUF+7
        ORA WK_BUF+14
                        BNE WK_BAD_META
WK_PROG_NEXT:
        INC WK_PROG_SLOT
        LDA WK_PROG_SLOT
        CMP #8
                        BNE WK_PROG_SCAN
        LDA #0
WK_PROG_RETURN:
        RTS
WK_RESIZE: LDX #7
WK_RESIZE_KEY:
        LDA WK_REQ+24,X
        CMP WK_RESIZE_MAGIC,X
                        BNE WK_BAD_ARG
        DEX
                        BPL WK_RESIZE_KEY
        LDA WK_REQ+21
                        BEQ WK_BAD_ARG
        CMP #5
                        BCS WK_BAD_ARG
        CMP WK_UNITS
                        BEQ WK_QUERY
        STA WK_NEW_UNITS
        ; Check prospective boundary against all saved records and claims.
        LDA WK_LAYOUT+5
        PHA
        LDA WK_LAYOUT+6
        PHA
        JSR WK_NEW_BOUNDARY
        JSR WK_PROGRAM_CHECK
        STA WK_ERROR
        STZ WK_SLOT
WK_RESIZE_CLAIMS:
        LDA WK_ERROR
                        BNE WK_RESIZE_RESTORE
        JSR WK_SLOT_POINTER
        LDY #31
        LDA (WK_P),Y
        CMP #$A5
                        BNE WK_RESIZE_NEXT
        LDY #14
        LDA (WK_P),Y
        CMP WK_LAYOUT+6
                        BCC WK_RESIZE_CONFLICT
                        BNE WK_RESIZE_NEXT
        DEY
        LDA (WK_P),Y
        CMP WK_LAYOUT+5
                        BCC WK_RESIZE_CONFLICT
WK_RESIZE_NEXT:
        INC WK_SLOT
        LDA WK_SLOT
        CMP #4
                        BNE WK_RESIZE_CLAIMS
                        BRA WK_RESIZE_RESTORE
WK_RESIZE_CONFLICT:
        LDA #$4A
        STA WK_ERROR
WK_RESIZE_RESTORE:
        PLA
        STA WK_LAYOUT+6
        PLA
        STA WK_LAYOUT+5
        LDA WK_ERROR
                        BNE WK_OP_RETURN
        JSR WK_REPAIR_PRIMARY
                        BNE WK_OP_RETURN
        JSR WK_NEW_BOUNDARY
        JSR WK_LAYOUT_INCREMENT
                        BNE WK_OP_RETURN
        JSR WK_LAYOUT_UPDATE
                        BNE WK_OP_RETURN
        LDA WK_NEW_UNITS
        STA WK_UNITS
        JMP WK_QUERY
WK_NEW_BOUNDARY:
        LDA WK_NEW_UNITS
        LSR A
        LSR A
        STA WK_LAYOUT+6
        LDA WK_NEW_UNITS
        ASL A
        ASL A
        ASL A
        ASL A
        ASL A
        ASL A
        STA WK_LAYOUT+5
        RTS
WK_LAYOUT_INCREMENT:
        LDX #0
WK_LAYOUT_INC:
        INC WK_LAYOUT+8,X
                        BNE WK_LAYOUT_INC_OK
        INX
        CPX #4
                        BNE WK_LAYOUT_INC
        JMP WK_EXHAUSTED
WK_LAYOUT_INC_OK:
        LDA #0
        RTS
WK_LAYOUT_PACKET:
        LDX #63
WK_LAYOUT_PACKET_COPY:
        LDA WK_LAYOUT,X
        STA WK_BUF,X
        DEX
                        BPL WK_LAYOUT_PACKET_COPY
        STZ WK_BUF+63
        LDA #64
        STA WK_N
        JSR WK_SEAL
        JMP WK_SAVE_PACKET
WK_LAYOUT_UPDATE:
        JSR WK_LAYOUT_PACKET
        JSR WK_ZERO_ADDR
        LDA #$40
        STA WK_ADDR
        LDA #2
        STA WK_ADDR+1
        JSR WK_PUBLISH
                        BNE WK_LAYOUT_WRITE_RETURN
        ; A remains authoritative until verified invalidation. Then B is
        ; authoritative; STORE refuses until A is repaired/republished.
        JSR WK_ZERO_ADDR
        LDA #64
        STA WK_PACKET_N
        LDA #0
        JSR WK_MARKER
                        BNE WK_LAYOUT_WRITE_RETURN
        BRA WK_WRITE_PRIMARY
WK_REPAIR_PRIMARY:
        LDA WK_FALLBACK
                        BEQ WK_LAYOUT_WRITE_RETURN
WK_WRITE_PRIMARY:
        JSR WK_LAYOUT_PACKET
        JSR WK_ZERO_ADDR
        LDA #64
        STA WK_N
        JSR WK_PUBLISH
                        BNE WK_LAYOUT_WRITE_RETURN
        STZ WK_FALLBACK
        LDA #0
WK_LAYOUT_WRITE_RETURN:
        RTS
WK_REPAIR: LDX #7
WK_REPAIR_KEY:
        LDA WK_REQ+24,X
        CMP WK_REPAIR_MAGIC,X
                        BNE WK_BAD_ARG
        DEX
                        BPL WK_REPAIR_KEY
        BRA WK_REPAIR_PRIMARY
WK_UPGRADE:
        LDX #7
WK_UPGRADE_KEY:
        LDA WK_REQ+24,X
        CMP WK_UPGRADE_MAGIC,X
                        BNE WK_BAD_ARG
        DEX
                        BPL WK_UPGRADE_KEY
        JSR WK_LOAD_LAYOUT
                        BNE WK_OP_RETURN
        LDA WK_LEGACY
                        BEQ WK_UPGRADE_ALREADY
        JSR WK_PROGRAM_CHECK
                        BNE WK_OP_RETURN
        JSR WK_INITIAL_SESSION
                        BNE WK_OP_RETURN
        LDA #2
        STA WK_LAYOUT+2
        LDA #1
        STA WK_LAYOUT+8
        JSR WK_LAYOUT_UPDATE
                        BNE WK_OP_RETURN
        STZ WK_LEGACY
WK_UPGRADE_ALREADY:
        LDA #0
        RTS
WK_FORMAT: LDX #7
WK_FORMAT_KEY:
        LDA WK_REQ+24,X
        CMP WK_FORMAT_MAGIC,X
                        BNE WK_BAD_ARG
        DEX
                        BPL WK_FORMAT_KEY
        ; Both layout markers invalidated before changing any record.
        JSR WK_ZERO_ADDR
        LDA #64
        STA WK_PACKET_N
        LDA #0
        JSR WK_MARKER
                        BNE WK_OP_RETURN
        LDA #$40
        STA WK_ADDR
        LDA #2
        STA WK_ADDR+1
        LDA #0
        JSR WK_MARKER
                        BNE WK_OP_RETURN
        STZ WK_PROG_SLOT
WK_FORMAT_DIRECTORY:
        LDA WK_PROG_SLOT
        INC A
        LSR A
        LSR A
        STA WK_ADDR+1
        LDA WK_PROG_SLOT
        INC A
        AND #3
        ASL A
        ASL A
        ASL A
        ASL A
        ASL A
        ASL A
        STA WK_ADDR
        LDA #0
        JSR WK_MARKER
                        BNE WK_OP_RETURN
        INC WK_PROG_SLOT
        LDA WK_PROG_SLOT
        CMP #8
                        BNE WK_FORMAT_DIRECTORY
        ; Clear every claim marker, including corrupt old-epoch packets.
        ; LOAD_CLAIMS validates committed headers before checking epochs.
        JSR WK_CLEAR_CLAIMS
                        BNE WK_OP_RETURN
        ; Retain a valid epoch counter when formatting an existing store.
        JSR WK_SESSION_LOAD
                        BNE WK_FORMAT_FRESH_SESSION
        JSR WK_NEW_EPOCH
                        BNE WK_OP_RETURN
                        BRA WK_FORMAT_LAYOUT
WK_FORMAT_FRESH_SESSION:
        JSR WK_INITIAL_SESSION_RECORD
                        BNE WK_OP_RETURN
WK_FORMAT_LAYOUT:
        JSR WK_ZERO_BUF
        LDX #7
WK_FORMAT_LAYOUT_COPY:
        LDA WK_INITIAL_LAYOUT,X
        STA WK_LAYOUT,X
        DEX
                        BPL WK_FORMAT_LAYOUT_COPY
        LDX #63
WK_FORMAT_LAYOUT_ZERO:
        STZ WK_LAYOUT,X
        DEX
        CPX #7
                        BNE WK_FORMAT_LAYOUT_ZERO
        LDA #1
        STA WK_LAYOUT+8
        STZ WK_FALLBACK
        JSR WK_LAYOUT_UPDATE
                        BNE WK_OP_RETURN
        LDA #0
        RTS
WK_CLEAR_CLAIMS:
        STZ WK_SLOT
WK_INIT_CLEAR_CLAIMS:
        JSR WK_CLAIM_ADDRESS
        LDA #32
        STA WK_PACKET_N
        LDA #0
        JSR WK_MARKER
                        BNE WK_INIT_RETURN
        INC WK_SLOT
        LDA WK_SLOT
        CMP #4
                        BNE WK_INIT_CLEAR_CLAIMS
        LDA #0
        RTS
WK_INITIAL_SESSION:
        ; Explicit FORMAT/UPGRADE initializes only management cells.
        JSR WK_CLEAR_CLAIMS
                        BNE WK_INIT_RETURN
WK_INITIAL_SESSION_RECORD:
        LDA #$80
        STA WK_ADDR
        LDA #2
        STA WK_ADDR+1
        LDA #64
        STA WK_PACKET_N
        LDA #0
        JSR WK_MARKER
                        BNE WK_INIT_RETURN
        LDA #$C0
        STA WK_ADDR
        LDA #0
        JSR WK_MARKER
                        BNE WK_INIT_RETURN
        JSR WK_ZERO_BUF
        LDX #2
WK_INIT_WS_MAGIC:
        LDA WK_WS_MAGIC,X
        STA WK_BUF,X
        DEX
                        BPL WK_INIT_WS_MAGIC
        LDA #1
        STA WK_BUF+4
        STA WK_BUF+8
        LDX #63
WK_INIT_SESSION_COPY:
        LDA WK_BUF,X
        STA WK_SESSION,X
        DEX
                        BPL WK_INIT_SESSION_COPY
        LDA #64
        STA WK_N
        JSR WK_SEAL
        JSR WK_SAVE_PACKET
        LDA #$80
        STA WK_ADDR
        STA WK_SESSION_ADDR
        JSR WK_PUBLISH
                        BNE WK_INIT_RETURN
        LDA #1
        STA WK_RESET_LATCH
        LDA #0
WK_INIT_RETURN:
        RTS
WK_CONSOLE:
        SEI
        CLD
        LDX #<WK_TITLE
        LDY #>WK_TITLE
        JSR WK_PRINT
WK_CON_HELP_TEXT:
        LDX #<WK_HELP_TEXT
        LDY #>WK_HELP_TEXT
        JSR WK_PRINT
WK_PROMPT: LDX #<WK_PROMPT_TEXT
        LDY #>WK_PROMPT_TEXT
        JSR WK_PRINT
        JSR B29_LINE_3
                        BCC WK_PROMPT
        LDX #31
WK_CON_CLEAR:
        STZ WK_REQ,X
        DEX
                        BPL WK_CON_CLEAR
        LDA WK_LINE
                        BEQ WK_PROMPT
        CMP #'P'
                        BEQ WK_CON_RESIZE
        CMP #'H'
                        BEQ WK_CON_HELP
        LDX WK_LINE+1
                        BNE WK_CON_BAD
        CMP #'!'
        BNE SW_WK_COMMAND
        JMP SW_CONTROLS
SW_WK_COMMAND:
        CMP #'Q'
        BEQ WK_QUIT
        CMP #'?'
                        BEQ WK_CON_QUERY
        CMP #'F'
                        BEQ WK_CON_FORMAT
        CMP #'U'
                        BEQ WK_CON_UPGRADE
        CMP #'V'
                        BEQ WK_CON_REPAIR
        LDA #$44
                        JMP WK_CON_RESULT
WK_CON_HELP:
        LDX #4
WK_CON_HELP_MATCH:
        LDA WK_LINE,X
        CMP WK_HELP_COMMAND,X
                        BNE WK_CON_BAD
        DEX
                        BPL WK_CON_HELP_MATCH
                        BRA WK_CON_HELP_TEXT
WK_CON_QUERY:
        JSR WK_OPERATION
                        BNE WK_CON_RESULT
        JSR WK_CAPACITY_TEXT
                        JMP WK_PROMPT
WK_CON_RESIZE:
        LDA WK_LINE+1
        CMP #' '
                        BNE WK_CON_BAD
        LDA WK_LINE+4
                        BNE WK_CON_BAD
        LDX #6
WK_CON_SIZE_MATCH:
        LDA WK_LINE+2
        CMP WK_UNIT_TEXT,X
                        BNE WK_CON_SIZE_NEXT
        LDA WK_LINE+3
        CMP WK_UNIT_TEXT+1,X
                        BEQ WK_CON_SIZE_FOUND
WK_CON_SIZE_NEXT:
        DEX
        DEX
                        BPL WK_CON_SIZE_MATCH
                        JMP WK_CON_BAD
WK_CON_SIZE_FOUND:
        TXA
        LSR A
        INC A
        STA WK_CON_UNITS
        JSR WK_OPERATION
                        BNE WK_CON_RESULT
        LDA WK_CON_UNITS
        CMP WK_REQ+21
                        BNE WK_CON_SIZE_PREVIEW
        LDX #<WK_NO_CHANGE_TEXT
        LDY #>WK_NO_CHANGE_TEXT
                        JMP WK_CON_MESSAGE
WK_CON_SIZE_PREVIEW:
        STA WK_REQ+21
        JSR WK_CAPACITY_TEXT
        LDA #5
        LDX #<WK_RESIZE_MAGIC
        LDY #>WK_RESIZE_MAGIC
                        JMP WK_CON_CONFIRM
WK_CON_FORMAT:
        LDA #6
        LDX #<WK_FORMAT_MAGIC
        LDY #>WK_FORMAT_MAGIC
                        JMP WK_CON_CONFIRM
WK_CON_UPGRADE:
        LDA #7
        LDX #<WK_UPGRADE_MAGIC
        LDY #>WK_UPGRADE_MAGIC
                        JMP WK_CON_CONFIRM
WK_CON_REPAIR:
        LDA #8
        LDX #<WK_REPAIR_MAGIC
        LDY #>WK_REPAIR_MAGIC
WK_CON_CONFIRM:
        STA WK_REQ
        STX WK_Q
        STY WK_Q+1
        LDY #7
WK_CON_KEY_COPY:
        LDA (WK_Q),Y
        STA WK_REQ+24,Y
        DEY
                        BPL WK_CON_KEY_COPY
        LDX #<WK_CONFIRM_TEXT
        LDY #>WK_CONFIRM_TEXT
        LDA WK_REQ
        CMP #6
                        BEQ WK_CON_FORMAT_PROMPT
        CMP #5
                        BNE WK_CON_PROMPT_CONFIRM
        LDX #<WK_APPLY_TEXT
        LDY #>WK_APPLY_TEXT
                        BRA WK_CON_PROMPT_CONFIRM
WK_CON_FORMAT_PROMPT:
        LDX #<WK_FORMAT_TEXT
        LDY #>WK_FORMAT_TEXT
WK_CON_PROMPT_CONFIRM:
        JSR WK_PRINT
        JSR WK_LINE_READ
                        BCC WK_CON_CANCEL
        LDA WK_REQ
        CMP #5
                        BEQ WK_CON_CHECK_Y
        CMP #6
                        BNE WK_CON_CHECK_YES
        LDX #11
WK_CON_FORMAT_CONFIRM:
        LDA WK_LINE,X
        CMP WK_FORMAT_CONFIRM,X
                        BNE WK_CON_CANCEL
        DEX
                        BPL WK_CON_FORMAT_CONFIRM
                        BRA WK_CON_EXEC
WK_CON_CHECK_Y:
        LDA WK_LINE
        CMP #'Y'
                        BNE WK_CON_CANCEL
        LDA WK_LINE+1
                        BEQ WK_CON_EXEC
                        BRA WK_CON_CANCEL
WK_CON_CHECK_YES:
        LDX #3
WK_CON_YES:
        LDA WK_LINE,X
        CMP WK_YES_MAGIC,X
                        BNE WK_CON_CANCEL
        DEX
                        BPL WK_CON_YES
WK_CON_EXEC:
        JSR WK_OPERATION
WK_CON_RESULT:
        CMP #0
                        BNE WK_CON_ERROR
        LDA WK_REQ
        SEC
        SBC #5
        TAX
        LDA WK_SUCCESS_LO,X
        LDY WK_SUCCESS_HI,X
        TAX
                        JMP WK_CON_MESSAGE
WK_CON_ERROR: JSR B29_ERROR_HOOK

        LDX #WK_STATUS_COUNT-1
WK_CON_STATUS_MATCH:
        CMP WK_STATUS_CODES,X
                        BEQ WK_CON_STATUS_TEXT
        DEX
                        BPL WK_CON_STATUS_MATCH
        PHA
        LDX #<WK_RESULT_TEXT
        LDY #>WK_RESULT_TEXT
        JSR WK_PRINT
        PLA
        JSR WK_HEX
        JSR WK_NL
        JMP WK_PROMPT
WK_CON_STATUS_TEXT:
        LDY WK_STATUS_HI,X
        LDA WK_STATUS_LO,X
        TAX
WK_CON_MESSAGE:
        JSR WK_PRINT
        JMP WK_PROMPT
WK_CON_CANCEL: JSR B29_ERROR_HOOK

        LDX #<WK_CANCELED_TEXT
        LDY #>WK_CANCELED_TEXT
                        JMP WK_CON_MESSAGE
WK_CON_BAD:LDA #$44
                        JMP WK_CON_RESULT
WK_QUIT:   JSR WK_RESTORE_WINDOW
        JMP SW_SUB_Q
; Four fixed layouts: small decimal tables avoid a general 24-bit formatter.
WK_CAPACITY_TEXT:
        LDX #<WK_PROGRAM_TEXT
        LDY #>WK_PROGRAM_TEXT
        JSR WK_PRINT
        LDA WK_REQ+21
        DEC A
        ASL A
        TAX
        LDA WK_UNIT_TEXT,X
        JSR WK_PUTC
        INX
        LDA WK_UNIT_TEXT,X
        JSR WK_PUTC
        LDX #<WK_WORKSPACE_TEXT
        LDY #>WK_WORKSPACE_TEXT
        JSR WK_PRINT
        LDA WK_REQ+21
        DEC A
        TAX
        LDY WK_CAPACITY_HI,X
        LDA WK_CAPACITY_LO,X
        TAX
        JSR WK_PRINT
        LDX #<WK_BYTES_TEXT
        LDY #>WK_BYTES_TEXT
        BRA WK_PRINT
WK_LINE_READ:
        STZ WK_LINE_N
        STZ WK_OVERFLOW
WK_LINE_WAIT:
        JSR WK_GETC
        CMP #3
                        BEQ WK_LINE_CANCEL
        CMP #$1B
                        BEQ WK_LINE_CANCEL
        CMP #10
                        BEQ WK_LINE_WAIT
        CMP #13
                        BEQ WK_LINE_END
        CMP #'a'
                        BCC WK_LINE_CHAR
        CMP #'z'+1
                        BCS WK_LINE_CHAR
        AND #$DF
WK_LINE_CHAR:
        LDX WK_LINE_N
        CPX #15
                        BCS WK_LINE_FULL
        STA WK_LINE,X
        INC WK_LINE_N
        JSR WK_PUTC
                        JMP WK_LINE_WAIT
WK_LINE_FULL:
        LDA #1
        STA WK_OVERFLOW
                        JMP WK_LINE_WAIT
WK_LINE_END:
        LDX WK_LINE_N
        STZ WK_LINE,X
        JSR WK_NL
        LDA WK_OVERFLOW
                        BNE WK_LINE_CANCEL
        SEC
        RTS
WK_LINE_CANCEL: JSR B29_CANCEL_HOOK

        JSR WK_NL
        CLC
        RTS
WK_PRINT:  STX WK_Q
        STY WK_Q+1
        LDY #0
WK_PRINT_LOOP:
        LDA (WK_Q),Y
                        BEQ WK_PRINT_END
        JSR WK_PUTC
        INY
                        BRA WK_PRINT_LOOP
WK_PRINT_END:
        RTS
WK_SV_MAGIC DB "SV",1
WK_SM_MAGIC DB "SM",1,1
WK_WS_MAGIC DB "WS",1
WK_WC_MAGIC DB "WC",1
WK_SP_MAGIC DB "SP",1
WK_INITIAL_LAYOUT DB "SS",2,8,8,0,1,0
WK_MAX_END DB $E0,$FF,1
WK_FORMAT_MAGIC DB "FORMAT!!"
WK_RESIZE_MAGIC DB "RESIZE!!"
WK_UPGRADE_MAGIC DB "UPGRADE!"
WK_REPAIR_MAGIC DB "REPAIR!!"
WK_YES_MAGIC DB "YES",0
WK_FORMAT_CONFIRM DB "FORMAT SRAM",0
WK_TITLE DB "WORK 1.4 / BASE1 PR05 gSW_GENERATION_TEXT",13,10,0
WK_HELP_COMMAND DB "HELP",0
WK_HELP_TEXT DB "? capacity; P 16/32/48/64 (KiB); U upgrade; V repair; F format; HELP; Q",13,10,0
WK_PROMPT_TEXT DB "WORK> ",0
WK_UNIT_TEXT DB "16324864"
WK_PROGRAM_TEXT DB "Programs: ",0
WK_WORKSPACE_TEXT DB " KiB; workspace: ",0
WK_BYTES_TEXT DB " bytes",13,10,0
WK_CAP16 DB "114656",0
WK_CAP32 DB "98272",0
WK_CAP48 DB "81888",0
WK_CAP64 DB "65504",0
WK_CAPACITY_LO DB <WK_CAP16,<WK_CAP32,<WK_CAP48,<WK_CAP64
WK_CAPACITY_HI DB >WK_CAP16,>WK_CAP32,>WK_CAP48,>WK_CAP64
WK_APPLY_TEXT DB "Apply? [y/N]: ",0
WK_CONFIRM_TEXT DB "Changes storage metadata. Type YES: ",0
WK_FORMAT_TEXT DB "Clear program/claim metadata. Type FORMAT SRAM: ",0
WK_RESULT_TEXT DB "WORK error: $",0
WK_NO_CHANGE_TEXT DB "No change.",13,10,0
WK_CANCELED_TEXT DB "Canceled.",13,10,0
WK_RESIZED_TEXT DB "Resized.",13,10,0
WK_FORMATTED_TEXT DB "Formatted.",13,10,0
WK_UPGRADED_TEXT DB "Upgraded.",13,10,0
WK_REPAIRED_TEXT DB "Repaired.",13,10,0
WK_SUCCESS_LO DB <WK_RESIZED_TEXT,<WK_FORMATTED_TEXT,<WK_UPGRADED_TEXT,<WK_REPAIRED_TEXT
WK_SUCCESS_HI DB >WK_RESIZED_TEXT,>WK_FORMATTED_TEXT,>WK_UPGRADED_TEXT,>WK_REPAIRED_TEXT
WK_STATUS_COUNT EQU 8
WK_STATUS_CODES DB $40,$41,$44,$45,$48,$49,$4A,$80
WK_UNINITIALIZED_TEXT DB "Storage not initialized.",13,10,0
WK_INVALID_STORAGE_TEXT DB "Storage invalid or program exceeds boundary.",13,10,0
WK_INVALID_COMMAND_TEXT DB "Invalid command. Use HELP.",13,10,0
WK_VERIFY_TEXT DB "Write verification failed.",13,10,0
WK_EXHAUSTED_TEXT DB "Counter exhausted.",13,10,0
WK_UPGRADE_TEXT DB "Upgrade required. Use U.",13,10,0
WK_CONFLICT_TEXT DB "Resize refused: workspace overlaps.",13,10,0
WK_ABSENT_TEXT DB "SPI SRAM unavailable.",13,10,0
WK_STATUS_LO DB <WK_UNINITIALIZED_TEXT,<WK_INVALID_STORAGE_TEXT,<WK_INVALID_COMMAND_TEXT,<WK_VERIFY_TEXT,<WK_EXHAUSTED_TEXT,<WK_UPGRADE_TEXT,<WK_CONFLICT_TEXT,<WK_ABSENT_TEXT
WK_STATUS_HI DB >WK_UNINITIALIZED_TEXT,>WK_INVALID_STORAGE_TEXT,>WK_INVALID_COMMAND_TEXT,>WK_VERIFY_TEXT,>WK_EXHAUSTED_TEXT,>WK_UPGRADE_TEXT,>WK_CONFLICT_TEXT,>WK_ABSENT_TEXT
