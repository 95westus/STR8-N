; Three RAM-only map views. M defaults to ranges; T returns to maintenance.
MM_MAP_VIEW EQU $6134
MM_MAP_ONCE EQU $6135
MM_MAP_META EQU $6136
MM_MAP_RANGE_END EQU $6138
MM_MAP_KIND EQU $613A
MM_MAP_START EQU $613B
