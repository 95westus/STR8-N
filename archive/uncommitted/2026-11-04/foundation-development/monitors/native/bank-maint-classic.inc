; Parser: uppercase hexadecimal, inclusive ranges, space R or bank 0-3.
MM_SPACES:                 LDX MM_INDEX
MM_SPACE_LOOP:             LDA MM_BM_LINE,X
                        CMP #' '
                        BNE MM_SPACE_DONE
                        INX
                        BRA MM_SPACE_LOOP
MM_SPACE_DONE:             STX MM_INDEX
                        CMP #$00
                        RTS
MM_ENDLINE:                JSR MM_SPACES
                        BNE MM_PARSE_NO
                        SEC
                        RTS
MM_BANK:                   JSR MM_SPACES
                        CMP #'R'
                        BEQ MM_BANK_RAM
                        SEC
                        SBC #'0'
                        CMP #$04
                        BCS MM_PARSE_NO
                        BRA MM_BANK_END
MM_BANK_RAM:               LDA #$FF
MM_BANK_END:               PHA
                        INC MM_INDEX
                        LDX MM_INDEX
                        LDA MM_BM_LINE,X
                        BEQ MM_BANK_OK
                        CMP #' '
                        BNE MM_BANK_BAD
MM_BANK_OK:                PLA
                        SEC
                        RTS
MM_BANK_BAD:               PLA
MM_PARSE_NO:               CLC
                        RTS
MM_NUMBER:                 JSR MM_SPACES
                        STZ MM_NUM
                        STZ MM_NUM+1
                        STZ MM_DIGITS
MM_NUMBER_LOOP:            LDX MM_INDEX
                        LDA MM_BM_LINE,X
                        JSR MM_NIBBLE
                        BCC MM_NUMBER_END
                        STA MM_BYTE
                        INC MM_DIGITS
                        LDA MM_DIGITS
                        CMP #$05
                        BCS MM_PARSE_NO
                        ASL MM_NUM
                        ROL MM_NUM+1
                        ASL MM_NUM
                        ROL MM_NUM+1
                        ASL MM_NUM
                        ROL MM_NUM+1
                        ASL MM_NUM
                        ROL MM_NUM+1
                        LDA MM_NUM
                        ORA MM_BYTE
                        STA MM_NUM
                        INC MM_INDEX
                        BRA MM_NUMBER_LOOP
MM_NUMBER_END:             LDA MM_DIGITS
                        BEQ MM_PARSE_NO
                        SEC
                        RTS
MM_RANGE:                  JSR MM_NUMBER
                        BCC MM_PARSE_NO
                        LDA MM_NUM
                        STA MM_FIRST
                        STA MM_LAST
                        LDA MM_NUM+1
                        STA MM_FIRST+1
                        STA MM_LAST+1
                        LDX MM_INDEX
                        LDA MM_BM_LINE,X
                        CMP #'-'
                        BNE MM_RANGE_ORDER
                        INC MM_INDEX
                        JSR MM_NUMBER
                        BCC MM_PARSE_NO
                        LDA MM_NUM
                        STA MM_LAST
                        LDA MM_NUM+1
                        STA MM_LAST+1
MM_RANGE_ORDER:            LDA MM_LAST
                        CMP MM_FIRST
                        LDA MM_LAST+1
                        SBC MM_FIRST+1
                        RTS
MM_SCALE_RANGE:            LDA MM_SB
                        CMP #$FF
                        BEQ MM_SCALE_DONE
                        LDA MM_FIRST+1
                        ORA MM_LAST+1
                        BNE MM_SCALE_DONE
                        LDA MM_FIRST
                        CMP #$08
                        BCC MM_SCALE_DONE
                        LDA MM_LAST
                        CMP #$10
                        BCS MM_SCALE_DONE
                        LDA MM_FIRST
                        ASL A
                        ASL A
                        ASL A
                        ASL A
                        STA MM_FIRST+1
                        STZ MM_FIRST
                        LDA MM_LAST
                        ASL A
                        ASL A
                        ASL A
                        ASL A
                        ORA #$0F
                        STA MM_LAST+1
                        LDA #$FF
                        STA MM_LAST
MM_SCALE_DONE:             RTS

MM_READLINE:               STZ MM_LINELEN
                        STZ MM_OVERFLOW
MM_LINE_WAIT:              JSR MM_GETC
                        CMP #$1B
                        BEQ MM_LINE_CANCEL
                        CMP #$03
                        BEQ MM_LINE_CANCEL
                        CMP #$0A
                        BEQ MM_LINE_WAIT
                        CMP #$0D
                        BEQ MM_LINE_DONE
                        CMP #$08
                        BEQ MM_LINE_BACK
                        CMP #$7F
                        BEQ MM_LINE_BACK
                        CMP #$20
                        BCC MM_LINE_WAIT
                        CMP #'a'
                        BCC MM_LINE_CHAR
                        CMP #'z'+1
                        BCS MM_LINE_CHAR
                        AND #$DF
MM_LINE_CHAR:              LDX MM_LINELEN
                        CPX #$4F
                        BCS MM_LINE_FULL
                        STA MM_BM_LINE,X
                        INC MM_LINELEN
                        JSR MM_PUTC
                        JMP MM_LINE_WAIT
MM_LINE_FULL:              LDA #$01
                        STA MM_OVERFLOW
                        JMP MM_LINE_WAIT
MM_LINE_BACK:              LDA MM_LINELEN
                        BEQ MM_LINE_WAIT
                        DEC MM_LINELEN
                        LDA #$08
                        JSR MM_PUTC
                        LDA #' '
                        JSR MM_PUTC
                        LDA #$08
                        JSR MM_PUTC
                        JMP MM_LINE_WAIT
MM_LINE_DONE:              LDX MM_LINELEN
                        STZ MM_BM_LINE,X
                        JSR MM_NL
                        LDA MM_OVERFLOW
                        BNE MM_LINE_CANCEL
                        SEC
                        RTS
MM_LINE_CANCEL: JSR B29_CANCEL_HOOK
            CLC
                        RTS
MM_PRINT:                  STX MM_TXT
                        STY MM_TXT+1
                        LDY #$00
MM_PRINT_BYTE:             LDA (MM_TXT),Y
                        BEQ MM_PRINT_DONE
                        JSR MM_PUTC
                        INY
                        BNE MM_PRINT_BYTE
                        INC MM_TXT+1
                        BRA MM_PRINT_BYTE
MM_PRINT_DONE:             RTS
MM_SPACE_NAME:             CMP #$FF
                        BEQ MM_SPACE_RAM
                        PHA
                        LDA #'B'
                        JSR MM_PUTC
                        PLA
                        ORA #'0'
                        JMP MM_PUTC
MM_SPACE_RAM:              LDA #'R'
                        JMP MM_PUTC

MM_TITLE:                  DB $0D,$0A,"STR8-N BANK MAINT 2.4 / BASE1 PR05 g1",$0D,$0A,0
MM_PROMPT:                 DB $0D,$0A,"BM> ",0
MM_HELP:                   DB "NAME [1-8 characters | CLEAR] (YES required)",13,10
                        DB $0D,$0A,"BANKS AND MEMORY",$0D,$0A
                        DB " M [1|2|3] Grid / ranges (default) / wear",$0D,$0A
                        DB " E bank 8[-F] Erase sectors",$0D,$0A
                        DB " C src range dst start Copy RAM or flash",$0D,$0A
                        DB " V src range dst start Compare RAM or flash",$0D,$0A
                        DB $0D,$0A,"EDITOR BUFFER (4 KiB)",$0D,$0A
                        DB " R src range Read into buffer",$0D,$0A
                        DB " D [offset[-end]] Display buffer",$0D,$0A
                        DB " P offset byte ... Patch bytes",$0D,$0A
                        DB " F offset[-end] byte Fill bytes",$0D,$0A
                        DB " N length byte Create filled buffer",$0D,$0A
                        DB " K Buffer CRC16",$0D,$0A
                        DB " W dst start Write buffer and verify",$0D,$0A
                        DB $0D,$0A,"CONTROL",$0D,$0A
                        DB " T [bank|first-last] Stored records",$0D,$0A
                        DB " J bank Boot selected bank",$0D,$0A
                        DB " Q Return to monitor",$0D,$0A
                        DB " ? Show this menu",$0D,$0A
                        DB $0D,$0A," src/dst: R = RAM, 0-3 = flash bank. Numbers are hex.",$0D,$0A
                        DB " Flash 8-F = sectors. Editor offsets: 000-FFF.",$0D,$0A
                        DB " Writes: Y. B1:8-A, B2 and B3 protected.",$0D,$0A,0
MM_BAD:                    DB "INVALID / PROTECTED RANGE",$0D,$0A,0
MM_CANCEL:                 DB "CANCELED (completed sectors retained)",$0D,$0A,0
MM_FAILED:                 DB "WRITE/VERIFY FAILED; STOPPED",$0D,$0A,0
MM_DONE:                   DB "VERIFIED",$0D,$0A,0
MM_PLAN_TEXT:              DB "PLAN ",0
MM_DEST_TEXT:              DB $0D,$0A,"DEST ",0
MM_CONFIRM_TEXT:           DB $0D,$0A,"WRITE? TYPE Y> ",0
MM_B3F_TEXT:               DB "B3:F includes boot code/config/vectors. TYPE B3F> ",0
MM_MATCH_TEXT:             DB "MATCH",$0D,$0A,0
MM_DIFFERENT_TEXT:         DB "DIFFERENT AT DEST ",0
MM_BUFFER_TEXT:            DB "BUFFER LOADED; D/P/F/K then W to commit",$0D,$0A,0
MM_EDITED_TEXT:            DB "BUFFER CHANGED; W to commit",$0D,$0A,0
MM_CRC_TEXT:               DB "CRC16-CCITT-FALSE ",0
MM_MAP_HEADER:             DB "SECTORS 8 9 A B C D E F (E=erased U=used)",$0D,$0A
                        DB "B3: A/B monitors; C/D journals; E S/R/T; F recovery (protected)",$0D,$0A,0
MM_RESET_TEXT:             DB " RESET ",0
MM_QUIT_TEXT:              DB "RESIDENT F CHANGED; stay in RAM or J bank",$0D,$0A,0
MM_TZ_PTR EQU $D6
MM_TZ_SUM EQU $6210
MM_TZ_CRC:
        LDA #$FF
        STA MM_TZ_SUM
        STA MM_TZ_SUM+1
        LDY #0
MM_TZ_CRC_BYTE:
        JSR X28_R5
        EOR MM_TZ_SUM+1
        STA MM_TZ_SUM+1
        LDX #8
MM_TZ_CRC_BIT:
        ASL MM_TZ_SUM
        ROL MM_TZ_SUM+1
                        BCC MM_TZ_CRC_NEXT
        LDA MM_TZ_SUM
        EOR #$21
        STA MM_TZ_SUM
        LDA MM_TZ_SUM+1
        EOR #$10
        STA MM_TZ_SUM+1
MM_TZ_CRC_NEXT:
        DEX
                        BNE MM_TZ_CRC_BIT
        INY
        CPY #28
                        BNE MM_TZ_CRC_BYTE
        RTS
MM_BN_READ:
        STZ MM_BN_LENGTH
        STZ MM_BN_FREE+1
        LDX #3
MM_BN_RESET:
        STZ MM_BN_SEQ,X
        DEX
                        BPL MM_BN_RESET
        LDA X28_BANK
        PHA
        LDA #3
        STA X28_BANK
        STZ MM_TZ_PTR
        LDA #$9C
        STA MM_TZ_PTR+1
MM_BN_SLOT:
        LDY #0
MM_BN_BLANK:
        JSR X28_R5
        CMP #$FF
                        BNE MM_BN_CHECK
        INY
        CPY #32
                        BNE MM_BN_BLANK
        LDA MM_BN_FREE+1
                        BNE MM_BN_NEXT
        LDA MM_TZ_PTR
        STA MM_BN_FREE
        LDA MM_TZ_PTR+1
        STA MM_BN_FREE+1
                        JMP MM_BN_NEXT
MM_BN_CHECK:
        LDY #31
        JSR X28_R5
                        BNE MM_BN_NEXT
        LDY #3
MM_BN_HEADER:
        JSR X28_R5
        CMP MM_BN_MAGIC,Y
                        BNE MM_BN_NEXT
        DEY
                        BPL MM_BN_HEADER
        JSR MM_TZ_CRC
        LDY #28
        JSR X28_R5
        CMP MM_TZ_SUM
                        BNE MM_BN_NEXT
        INY
        JSR X28_R5
        CMP MM_TZ_SUM+1
                        BNE MM_BN_NEXT
        LDY #8
        JSR X28_R5
        CMP #9
                        BCS MM_BN_NEXT
        STA MM_BN_WORK
        TAX
MM_BN_CHAR_CHECK:
        INY
        CPY #17
                        BEQ MM_BN_NEWEST
        JSR X28_R5
        CPX #0
                        BEQ MM_BN_PADDING
        CMP #$21
                        BCC MM_BN_NEXT
        CMP #$7F
                        BCS MM_BN_NEXT
        DEX
                        JMP MM_BN_CHAR_CHECK
MM_BN_PADDING:
        CMP #0
                        BNE MM_BN_NEXT
                        JMP MM_BN_CHAR_CHECK
MM_BN_NEWEST:
        LDY #7
        LDX #3
MM_BN_NEWER:
        JSR X28_R5
        CMP MM_BN_SEQ,X
                        BCC MM_BN_NEXT
                        BNE MM_BN_KEEP
        DEY
        DEX
                        BPL MM_BN_NEWER
MM_BN_KEEP:
        LDY #7
        LDX #3
MM_BN_COPY_SEQ:
        JSR X28_R5
        STA MM_BN_SEQ,X
        DEY
        DEX
                        BPL MM_BN_COPY_SEQ
        LDA MM_BN_WORK
        STA MM_BN_LENGTH
        LDY #9
        LDX #0
MM_BN_COPY:
        JSR X28_R5
        STA MM_BN_TEXT,X
        INY
        INX
        CPX #8
                        BNE MM_BN_COPY
MM_BN_NEXT:
        LDA MM_TZ_PTR
        CLC
        ADC #32
        STA MM_TZ_PTR
                        BCC MM_BN_PAGE
        INC MM_TZ_PTR+1
MM_BN_PAGE:
        LDA MM_TZ_PTR+1
        CMP #$A0
                        BNE MM_BN_SLOT
        PLA
        STA X28_BANK
        RTS
MM_BN_SHOW:
        JSR MM_BN_READ
        LDA MM_BN_LENGTH
                        BEQ MM_BN_SHOW_DONE
        LDX #<MM_BN_LABEL
        LDY #>MM_BN_LABEL
        JSR MM_PRINT
        LDX #0
MM_BN_PRINT:
        LDA MM_BN_TEXT,X
        JSR $7E6D
        INX
        CPX MM_BN_LENGTH
                        BNE MM_BN_PRINT
        JSR $7E7F
MM_BN_SHOW_DONE:
        RTS
MM_BN_MAGIC DB "BN",1,0
MM_BN_LABEL DB "Board: ",0
MM_BN_LENGTH EQU $6212
MM_BN_WORK EQU $6213
MM_BN_TEXT EQU $6214
MM_BN_SEQ EQU $621C
MM_BN_FREE EQU $6220
; NAME [1..8 non-space printable characters | CLEAR]. READLINE canonicalizes case.
; Recognize the whole word before the existing N (new-sector buffer) command.
MM_BN_TRY:
        LDX #3
MM_BN_COMMAND_WORD:
        LDA MM_BM_LINE,X
        CMP MM_BN_WORD,X
                        BNE MM_BN_NOT_COMMAND
        DEX
                        BPL MM_BN_COMMAND_WORD
        LDA MM_LINELEN
        CMP #4
                        BEQ MM_BN_QUERY
        LDA MM_BM_LINE+4
        CMP #' '
                        BNE MM_BN_BAD
        LDA MM_LINELEN
        SEC
        SBC #5
                        BEQ MM_BN_BAD
        CMP #9
                        BCS MM_BN_BAD
        STA MM_BN_PENDING_LENGTH
        LDX #7
MM_BN_ZERO_PENDING:
        STZ MM_BN_PENDING,X
        DEX
                        BPL MM_BN_ZERO_PENDING
        LDX #0
MM_BN_ARGUMENT:
        LDA MM_BM_LINE+5,X
        CMP #$21
                        BCC MM_BN_BAD
        CMP #$7F
                        BCS MM_BN_BAD
        STA MM_BN_PENDING,X
        INX
        CPX MM_BN_PENDING_LENGTH
                        BNE MM_BN_ARGUMENT
        LDA MM_BN_PENDING_LENGTH
        CMP #5
                        BNE MM_BN_PREPARE
        LDX #4
MM_BN_CLEAR_WORD:
        LDA MM_BN_PENDING,X
        CMP MM_BN_CLEAR_TEXT,X
                        BNE MM_BN_PREPARE
        DEX
                        BPL MM_BN_CLEAR_WORD
        STZ MM_BN_PENDING_LENGTH
        LDX #7
MM_BN_CLEAR_PENDING:
        STZ MM_BN_PENDING,X
        DEX
                        BPL MM_BN_CLEAR_PENDING
MM_BN_PREPARE:
        JSR MM_BN_READ
        LDA MM_BN_PENDING_LENGTH
        CMP MM_BN_LENGTH
                        BNE MM_BN_CONFIRM
                        BEQ MM_BN_COMPARE_START
MM_BN_COMPARE_START:
        TAX
                        BEQ MM_BN_QUERY
        DEX
MM_BN_COMPARE:
        LDA MM_BN_PENDING,X
        CMP MM_BN_TEXT,X
                        BNE MM_BN_CONFIRM
        DEX
                        BPL MM_BN_COMPARE
                        JMP MM_BN_QUERY
MM_BN_CONFIRM:
        LDX #<MM_BN_WARNING
        LDY #>MM_BN_WARNING
        JSR MM_PRINT
        JSR MM_READLINE
                        BCC MM_BM_CANCEL
        LDA MM_LINELEN
        CMP #3
                        BNE MM_BM_CANCEL
        LDX #2
MM_BN_YES:
        LDA MM_BM_LINE,X
        CMP MM_BN_YES_TEXT,X
                        BNE MM_BM_CANCEL
        DEX
                        BPL MM_BN_YES
        JSR MM_BN_SAVE
                        BCC MM_BN_FAILED
MM_BN_QUERY:
        JSR MM_BN_SHOW
        LDA MM_BN_LENGTH
                        BNE MM_BN_MENU
        LDX #<MM_BN_UNNAMED
        LDY #>MM_BN_UNNAMED
        JSR MM_PRINT
MM_BN_MENU:
        JMP MM_BM_MENU
MM_BN_BAD: JSR B29_ERROR_HOOK

        LDX #<MM_BN_USAGE
        LDY #>MM_BN_USAGE
        JMP MM_MESSAGE
MM_BN_FAILED: JSR B29_ERROR_HOOK

        LDX #<MM_BN_FAILURE
        LDY #>MM_BN_FAILURE
        JMP MM_MESSAGE
MM_BN_NOT_COMMAND:
        CLC
        RTS
MM_BN_WORD DB "NAME"
MM_BN_CLEAR_TEXT DB "CLEAR"
MM_BN_YES_TEXT DB "YES"
MM_BN_WARNING DB "Save board name? Type YES: ",0
MM_BN_USAGE DB "NAME [1-8 characters | CLEAR]",13,10,0
MM_BN_UNNAMED DB "Board: unnamed",13,10,0
MM_BN_FAILURE DB "Name not saved; full, incompatible or write failed. No erase.",13,10,0
MM_BN_PENDING_LENGTH EQU $6222
MM_BN_PENDING EQU $6223
MM_BN_SAVE:
        LDA X28_BANK
        PHA
        LDA #3
        STA X28_BANK
        LDX #3
MM_BN_FORMAT_CHECK:
        JSR X28_R19
        CMP MM_BN_JOURNAL_MAGIC,X
                        BNE MM_BN_FORMAT_BAD
        DEX
                        BPL MM_BN_FORMAT_CHECK
        PLA
        STA X28_BANK
        JSR MM_BN_READ
        LDA MM_BN_FREE+1
                        BEQ MM_BN_REFUSE
        LDX #3
MM_BN_SEQ_FULL:
        LDA MM_BN_SEQ,X
        CMP #$FF
                        BNE MM_BN_RECORD
        DEX
                        BPL MM_BN_SEQ_FULL
MM_BN_REFUSE:
        CLC
        RTS
MM_BN_FORMAT_BAD:
        PLA
        STA X28_BANK
                        JMP MM_BN_REFUSE
MM_BN_RECORD:
        LDX #31
        LDA #$FF
MM_BN_FILL:
        STA MM_BN_RECORD_BYTES,X
        DEX
                        BPL MM_BN_FILL
        LDX #3
MM_BN_RECORD_HEADER:
        LDA MM_BN_MAGIC,X
        STA MM_BN_RECORD_BYTES,X
        DEX
                        BPL MM_BN_RECORD_HEADER
        INC MM_BN_SEQ
                        BNE MM_BN_SEQUENCE_READY
        INC MM_BN_SEQ+1
                        BNE MM_BN_SEQUENCE_READY
        INC MM_BN_SEQ+2
                        BNE MM_BN_SEQUENCE_READY
        INC MM_BN_SEQ+3
MM_BN_SEQUENCE_READY:
        LDX #3
MM_BN_SEQUENCE:
        LDA MM_BN_SEQ,X
        STA MM_BN_RECORD_BYTES+4,X
        DEX
                        BPL MM_BN_SEQUENCE
        LDA MM_BN_PENDING_LENGTH
        STA MM_BN_RECORD_BYTES+8
        LDX #7
MM_BN_PAYLOAD:
        LDA MM_BN_PENDING,X
        STA MM_BN_RECORD_BYTES+9,X
        DEX
                        BPL MM_BN_PAYLOAD
        LDA #<MM_BN_RECORD_BYTES
        STA MM_TZ_PTR
        LDA #>MM_BN_RECORD_BYTES
        STA MM_TZ_PTR+1
        JSR MM_TZ_CRC
        LDA MM_TZ_SUM
        STA MM_BN_RECORD_BYTES+28
        LDA MM_TZ_SUM+1
        STA MM_BN_RECORD_BYTES+29
        LDX #31
MM_BN_SAVE_ZP:
        LDA $E0,X
        STA MM_BN_ZP,X
        DEX
                        BPL MM_BN_SAVE_ZP
        LDA X28_BANK
        STA MM_BN_BANK
        LDA #3
        STA X28_BANK
        LDA $7FA0
        STA MM_BN_LED
        LDA #3
        STA $F3
        LDA #1
        STA $F4
        STZ MM_BN_INDEX
        STZ MM_BN_ERROR
MM_BN_WRITE:
        LDX MM_BN_INDEX
        LDA MM_BN_RECORD_BYTES,X
        CMP #$FF
                        BEQ MM_BN_NEXT_BYTE
        STA $F0
        TXA
        CLC
        ADC MM_BN_FREE
        STA $E4
        LDA MM_BN_FREE+1
        ADC #0
        STA $E5
        JSR X28_C9
                        BCC MM_BN_WRITE_FAILED
MM_BN_NEXT_BYTE:
        INC MM_BN_INDEX
        LDA MM_BN_INDEX
        CMP #31
                        BNE MM_BN_WRITE
        LDA MM_BN_FREE
        STA MM_TZ_PTR
        LDA MM_BN_FREE+1
        STA MM_TZ_PTR+1
        LDY #30
MM_BN_VERIFY:
        JSR X28_R5
        CMP MM_BN_RECORD_BYTES,Y
                        BNE MM_BN_WRITE_FAILED
        DEY
                        BPL MM_BN_VERIFY
        LDA MM_BN_FREE
        CLC
        ADC #31
        STA $E4
        LDA MM_BN_FREE+1
        ADC #0
        STA $E5
        STZ $F0
        JSR X28_C9
                        BCC MM_BN_WRITE_FAILED
        LDY #31
        JSR X28_R5
                        BNE MM_BN_WRITE_FAILED
                        BRA MM_BN_RESTORE
MM_BN_WRITE_FAILED:
        INC MM_BN_ERROR
MM_BN_RESTORE:
        LDA MM_BN_LED
        STA $7FA0
        LDA MM_BN_BANK
        STA X28_BANK
        LDX #31
MM_BN_RESTORE_ZP:
        LDA MM_BN_ZP,X
        STA $E0,X
        DEX
                        BPL MM_BN_RESTORE_ZP
        LDA MM_BN_ERROR
                        BNE MM_BN_REFUSE
        JSR MM_BN_READ
        LDA MM_BN_LENGTH
        CMP MM_BN_PENDING_LENGTH
                        BNE MM_BN_REFUSE
        LDX #7
MM_BN_READBACK:
        LDA MM_BN_TEXT,X
        CMP MM_BN_PENDING,X
                        BNE MM_BN_REFUSE
        DEX
                        BPL MM_BN_READBACK
        SEC
        RTS
MM_BN_JOURNAL_MAGIC DB "PJ",6,1
MM_BN_BANK EQU $622B
MM_BN_LED EQU $622C
MM_BN_INDEX EQU $622D
MM_BN_ERROR EQU $622E
MM_BN_RECORD_BYTES EQU $622F
MM_BN_ZP EQU $624F

; Called while bank 2 is visible. Identify sealed assets, never by address alone.
