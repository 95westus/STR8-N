SHELL:
 LDX #<PROMPT
 LDY #>PROMPT
 JSR PRINT
 STZ ERROR
 STZ LINENO
 STZ LINENO+1
 JSR READ_LINE
 LDA ERROR
 BNE SHELL_ERROR
 LDX #$00
 JSR SPACES
 BEQ SHELL
 CMP #'0'
 BCC SHELL_COMMAND
 CMP #'9'+1
 BCS SHELL_COMMAND
 JSR EDIT_LINE
 LDA ERROR
 BNE SHELL_ERROR
 JMP SHELL
SHELL_COMMAND:
 CMP #'?'
 BNE SHELL_WORD
 INX
 JSR END_LINE
 LDA ERROR
 BNE SHELL_ERROR
 LDX #<HELP
 LDY #>HELP
 JSR PRINT
 JMP SHELL
SHELL_WORD:
 JSR READ_TOKEN
 JSR END_LINE
 LDA ERROR
 BNE SHELL_ERROR
 LDA TOKEN
 CMP #'N'
 BNE SHELL_NOT_NEW
 LDX #<CMD_NEW
 LDY #>CMD_NEW
 JSR MATCH_TOKEN
 BCC SHELL_BAD
 LDA #>SOURCE_START
 STA SRC_END+1
 STZ SRC_END
 STZ RESULT_VALID
 JMP SHELL
SHELL_NOT_NEW:
 CMP #'L'
 BNE SHELL_NOT_LIST
 LDX #<CMD_LIST
 LDY #>CMD_LIST
 JSR MATCH_TOKEN
 BCC SHELL_BAD
 JSR LIST_SOURCE
 JMP SHELL
SHELL_NOT_LIST:
 CMP #'A'
 BNE SHELL_NOT_ASM
 LDX #<CMD_ASM
 LDY #>CMD_ASM
 JSR MATCH_TOKEN
 BCC SHELL_BAD
 JSR ASM_ASSEMBLE
 BCS SHELL_ERROR
 LDX #<OK_TEXT
 LDY #>OK_TEXT
 JSR PRINT
 LDA RESULT_LEN
 STA VAL
 LDA RESULT_LEN+1
 STA VAL+1
 JSR DECIMAL_OUT
 LDX #<ORIGIN_TEXT
 LDY #>ORIGIN_TEXT
 JSR PRINT
 LDA RESULT_ORIGIN+1
 JSR STR8V2_RAM_HEX_OUT
 LDA RESULT_ORIGIN
 JSR STR8V2_RAM_HEX_OUT
 LDX #<BUFFER_TEXT
 LDY #>BUFFER_TEXT
 JSR PRINT
 JSR SAVE_SUMMARY
 JMP SHELL
SHELL_NOT_ASM:
 CMP #'D'
 BNE SHELL_NOT_DUMP
 LDX #<CMD_DUMP
 LDY #>CMD_DUMP
 JSR MATCH_TOKEN
 BCC SHELL_BAD
 JSR REQUIRE_RESULT
 BCS SHELL
 JSR DUMP_OUTPUT
 JMP SHELL
SHELL_NOT_DUMP:
 CMP #'S'
 BNE SHELL_NOT_S19
 LDX #<CMD_S19
 LDY #>CMD_S19
 JSR MATCH_TOKEN
 BCC SHELL_BAD
 JSR REQUIRE_RESULT
 BCS SHELL
 JSR S19_OUTPUT
 JMP SHELL
SHELL_NOT_S19:
 CMP #'P'
 BNE SHELL_NOT_PASTE
 LDX #<CMD_PASTE
 LDY #>CMD_PASTE
 JSR MATCH_TOKEN
 BCC SHELL_BAD
 JSR PASTE_SOURCE
 LDA ERROR
 BNE SHELL_ERROR
 JMP SHELL
SHELL_NOT_PASTE:
 CMP #'Q'
 BNE SHELL_BAD
 LDX #<CMD_QUIT
 LDY #>CMD_QUIT
 JSR MATCH_TOKEN
 BCC SHELL_BAD
 JMP STR8V2_RAM_HOLD
SHELL_BAD:
 LDA #E_SYNTAX
 STA ERROR
SHELL_ERROR:
 JSR REPORT_ERROR
 JMP SHELL

; Console routines preserve parser X/Y except READ_LINE and DECIMAL_OUT.
PUTC:
 PHX
 PHY
 JSR STR8V2_RAM_PUTC
 PLY
 PLX
 RTS
PRINT:
 STX TEMP
 STY TEMP+1
 LDY #$00
PRINT_LOOP:
 LDA (TEMP),Y
 BEQ PRINT_END
 JSR PUTC
 INY
 BRA PRINT_LOOP
PRINT_END:
 RTS
READ_LINE:
 LDX #$00
 STZ LINE_LEN
READ_CHAR:
 JSR STR8V2_RAM_GETC
 CMP #$03
 BEQ READ_CANCEL
 CMP #$0A
 BNE READ_NOT_LF
 LDA SKIP_LF
 BNE READ_CHAR
 LDA #$0A
READ_NOT_LF:
 STZ SKIP_LF
 CMP #$0D
 BEQ READ_CR
 CMP #$0A
 BEQ READ_DONE
 CMP #$08
 BEQ READ_BACK
 CMP #$7F
 BEQ READ_BACK
 CMP #$09
 BNE READ_PRINTABLE
 LDA #' '
READ_PRINTABLE:
 CMP #$20
 BCC READ_CHAR
 CMP #$7F
 BCS READ_CHAR
 CPX #LINE_MAX
 BCS READ_OVERFLOW
 STA LINE,X
 INX
 LDY PASTE_MODE
 BNE READ_CHAR
 JSR PUTC
 BRA READ_CHAR
READ_OVERFLOW:
 LDA #E_LINE
 STA ERROR
 BRA READ_CHAR
READ_BACK:
 CPX #$00
 BEQ READ_CHAR
 DEX
 LDA PASTE_MODE
 BNE READ_CHAR
 LDA #$08
 JSR PUTC
 LDA #' '
 JSR PUTC
 LDA #$08
 JSR PUTC
 BRA READ_CHAR
READ_CR:
 INC SKIP_LF
READ_DONE:
 STX LINE_LEN
 STZ LINE,X
 LDA PASTE_MODE
 BNE READ_PASTE_DONE
 JSR STR8V2_RAM_NEWLINE
READ_PASTE_DONE:
 RTS
READ_CANCEL:
 LDA #E_CANCEL
 STA ERROR
 BRA READ_DONE

MATCH_TOKEN:
 STX TEMP
 STY TEMP+1
 LDY #$00
MATCH_LOOP:
 LDA (TEMP),Y
 CMP TOKEN,Y
 BNE MATCH_FAIL
 CMP #$00
 BEQ MATCH_OK
 INY
 BRA MATCH_LOOP
MATCH_OK:
 SEC
 RTS
MATCH_FAIL:
 CLC
 RTS

DECIMAL_OUT:
 LDX #$00
 STZ SAVE
DECIMAL_DIGIT:
 STZ DIGIT
DECIMAL_SUB:
 SEC
 LDA VAL
 SBC DECIMAL_POWERS,X
 STA NUMBER
 LDA VAL+1
 SBC DECIMAL_POWERS+1,X
 BCC DECIMAL_PRINT
 STA VAL+1
 LDA NUMBER
 STA VAL
 INC DIGIT
 BRA DECIMAL_SUB
DECIMAL_PRINT:
 LDA DIGIT
 BNE DECIMAL_NONZERO
 LDA SAVE
 BNE DECIMAL_NONZERO
 CPX #$08
 BNE DECIMAL_NEXT
DECIMAL_NONZERO:
 INC SAVE
 LDA DIGIT
 CLC
 ADC #'0'
 JSR PUTC
DECIMAL_NEXT:
 INX
 INX
 CPX #$0A
 BNE DECIMAL_DIGIT
 RTS
DECIMAL_POWERS:
 DW 10000,1000,100,10,1

REPORT_ERROR:
 LDX #<ERROR_TEXT
 LDY #>ERROR_TEXT
 JSR PRINT
 LDA LINENO
 STA VAL
 LDA LINENO+1
 STA VAL+1
 JSR DECIMAL_OUT
 LDA #':'
 JSR PUTC
 LDA #' '
 JSR PUTC
 LDA ERROR
 DEC A
 ASL A
 TAX
 LDA ERROR_MESSAGES,X
 PHA
 LDY ERROR_MESSAGES+1,X
 PLX
 JSR PRINT
 JMP STR8V2_RAM_NEWLINE
REQUIRE_RESULT:
 LDA RESULT_VALID
 BNE RESULT_OK
 LDX #<NO_RESULT
 LDY #>NO_RESULT
 JSR PRINT
 SEC
 RTS
RESULT_OK:
 CLC
 RTS
OUTPUT_SETUP:
 STZ PTR
 LDA #>OUTPUT_START
 STA PTR+1
 LDA RESULT_LEN
 STA ENDPTR
 CLC
 LDA RESULT_LEN+1
 ADC #>OUTPUT_START
 STA ENDPTR+1
 LDA RESULT_ORIGIN
 STA PC
 LDA RESULT_ORIGIN+1
 STA PC+1
 RTS
OUTPUT_MORE:
 LDA PTR+1
 CMP ENDPTR+1
 BNE OUTPUT_MORE_YES
 LDA PTR
 CMP ENDPTR
OUTPUT_MORE_YES:
 RTS

; Report physical, inclusive RAM bounds. A runnable Store suggestion is
; only valid when the logical origin matches the physical output buffer.
; ENDPTR is scratch; OUTPUT_SETUP refreshes it for DUMP/S19.
SAVE_SUMMARY:
 LDA RESULT_LEN
 ORA RESULT_LEN+1
 BEQ SAVE_EMPTY
 JSR OUTPUT_SETUP
 SEC
 LDA ENDPTR
 SBC #1
 STA ENDPTR
 LDA ENDPTR+1
 SBC #0
 STA ENDPTR+1
 LDX #<RAM_RANGE_TEXT
 LDY #>RAM_RANGE_TEXT
 JSR PRINT
 JSR SAVE_END_OUT
 JSR STR8V2_RAM_NEWLINE
 LDA RESULT_ORIGIN
 CMP #<OUTPUT_START
 BNE SAVE_RELOCATED
 LDA RESULT_ORIGIN+1
 CMP #>OUTPUT_START
 BNE SAVE_RELOCATED
 LDX #<SAVE_HINT_TEXT
 LDY #>SAVE_HINT_TEXT
 JSR PRINT
 LDX #<SAVE_COMMAND_TEXT
 LDY #>SAVE_COMMAND_TEXT
 JSR PRINT
 JSR SAVE_END_OUT
 LDX #<SAVE_NAME_TEXT
 LDY #>SAVE_NAME_TEXT
 JMP PRINT
SAVE_END_OUT:
 LDA ENDPTR+1
 JSR STR8V2_RAM_HEX_OUT
 LDA ENDPTR
 JMP STR8V2_RAM_HEX_OUT
SAVE_EMPTY:
 LDX #<EMPTY_TEXT
 LDY #>EMPTY_TEXT
 JMP PRINT
SAVE_RELOCATED:
 LDX #<RELOCATED_TEXT
 LDY #>RELOCATED_TEXT
 JMP PRINT

DUMP_OUTPUT:
 JSR OUTPUT_SETUP
DUMP_ROW:
 JSR OUTPUT_MORE
 BEQ DUMP_DONE
 LDA PC+1
 JSR STR8V2_RAM_HEX_OUT
 LDA PC
 JSR STR8V2_RAM_HEX_OUT
 LDA #':'
 JSR PUTC
 LDX #$10
DUMP_BYTE:
 LDA #' '
 JSR PUTC
 LDA (PTR)
 PHX
 JSR STR8V2_RAM_HEX_OUT
 PLX
 JSR OUTPUT_ADVANCE
 JSR OUTPUT_MORE
 BEQ DUMP_NEWLINE
 DEX
 BNE DUMP_BYTE
DUMP_NEWLINE:
 JSR STR8V2_RAM_NEWLINE
 JSR STR8V2_RAM_CHECK_CANCEL
 BCC DUMP_ROW
DUMP_DONE:
 RTS
OUTPUT_ADVANCE:
 INC PTR
 BNE OUTPUT_PC
 INC PTR+1
OUTPUT_PC:
 INC PC
 BNE OUTPUT_ADVANCE_DONE
 INC PC+1
OUTPUT_ADVANCE_DONE:
 RTS

S19_OUTPUT:
 JSR OUTPUT_SETUP
S19_ROW:
 JSR OUTPUT_MORE
 BEQ S19_FINISH
 SEC
 LDA ENDPTR
 SBC PTR
 STA SREC_COUNT
 LDA ENDPTR+1
 SBC PTR+1
 BNE S19_FULL
 LDA SREC_COUNT
 CMP #$11
 BCC S19_COUNT
S19_FULL:
 LDA #$10
 STA SREC_COUNT
S19_COUNT:
 LDA #'S'
 JSR PUTC
 LDA #'1'
 JSR PUTC
 STZ SREC_SUM
 LDA SREC_COUNT
 CLC
 ADC #$03
 JSR S19_HEX
 LDA PC+1
 JSR S19_HEX
 LDA PC
 JSR S19_HEX
S19_DATA:
 LDA (PTR)
 JSR S19_HEX
 JSR OUTPUT_ADVANCE
 DEC SREC_COUNT
 BNE S19_DATA
 JSR S19_CHECKSUM
 JSR STR8V2_RAM_CHECK_CANCEL
 BCC S19_ROW
 RTS
S19_FINISH:
 LDA #'S'
 JSR PUTC
 LDA #'9'
 JSR PUTC
 STZ SREC_SUM
 LDA #$03
 JSR S19_HEX
 LDA RESULT_ORIGIN+1
 JSR S19_HEX
 LDA RESULT_ORIGIN
 JSR S19_HEX
S19_CHECKSUM:
 LDA SREC_SUM
 EOR #$FF
 JSR STR8V2_RAM_HEX_OUT
 JMP STR8V2_RAM_NEWLINE
S19_HEX:
 PHA
 CLC
 ADC SREC_SUM
 STA SREC_SUM
 PLA
 JMP STR8V2_RAM_HEX_OUT

BANNER: DB $0D,$0A,"STR8-N ASM 0.5 / 65C02",$0D,$0A,0
PROMPT: DB "ASM> ",0
HELP: DB "number text: insert/replace; number: delete",$0D,$0A
 DB "NEW PASTE LIST ASM DUMP S19 QUIT ?",$0D,$0A
 DB "Labels: name:  Constants: name = value",$0D,$0A
 DB "ORG BYTE WORD TEXT FILL END (optional dot)",$0D,$0A
 DB "ORG address[,fill] (default fill $00)",$0D,$0A
 DB "Local .name: belongs to preceding global label",$0D,$0A,0
CMD_NEW: DB "NEW",0
CMD_LIST: DB "LIST",0
CMD_ASM: DB "ASM",0
CMD_DUMP: DB "DUMP",0
CMD_S19: DB "S19",0
CMD_PASTE: DB "PASTE",0
CMD_QUIT: DB "QUIT",0
OK_TEXT: DB "OK ",0
ORIGIN_TEXT: DB " bytes, origin $",0
BUFFER_TEXT: DB ", buffer $0200",$0D,$0A,0
RAM_RANGE_TEXT: DB "RAM $0200-$",0
SAVE_HINT_TEXT: DB "After QUIT; change bank/name as needed:",$0D,$0A,0
SAVE_COMMAND_TEXT: DB "S 1 AUTO 0200 ",0
SAVE_NAME_TEXT: DB " PROGRAM",$0D,$0A,0
EMPTY_TEXT: DB "RAM empty; nothing to save.",$0D,$0A,0
RELOCATED_TEXT: DB "ORG differs; use S19/load at origin before Store.",$0D,$0A,0
ERROR_TEXT: DB "Error line ",0
NO_RESULT: DB "Assemble successfully first",$0D,$0A,0
ERROR_MESSAGES:
 DW ERR_SYNTAX,ERR_OPCODE,ERR_UNDEFINED,ERR_DUPLICATE,ERR_RANGE,ERR_BRANCH
 DW ERR_SOURCE,ERR_SYMBOLS,ERR_OUTPUT,ERR_PHASE,ERR_LINE,ERR_DEPTH,ERR_CANCEL,ERR_LAYOUT,ERR_SCOPE
ERR_SYNTAX: DB "Syntax",0
ERR_OPCODE: DB "Unknown instruction or mode",0
ERR_UNDEFINED: DB "Undefined symbol",0
ERR_DUPLICATE: DB "Duplicate symbol",0
ERR_RANGE: DB "Value out of range",0
ERR_BRANCH: DB "Branch out of range",0
ERR_SOURCE: DB "Source full",0
ERR_SYMBOLS: DB "Symbols full",0
ERR_OUTPUT: DB "Output full",0
ERR_PHASE: DB "Layout changed between passes",0
ERR_LINE: DB "Line too long",0
ERR_DEPTH: DB "Expression too deep",0
ERR_CANCEL: DB "Cancelled",0
ERR_LAYOUT: DB "Layout value must be defined earlier",0
ERR_SCOPE: DB "Local needs preceding global label",0
