; Packed sorted records: decimal line number (word), text length, pass-1 mode,
; then text bytes. Header size is 4; no per-record terminator is stored.
EDIT_LINE:
 LDA #$0A
 STA RADIX
 JSR READ_NUMBER
 LDA ERROR
 BNE EDIT_RETURN
 LDA VAL
 STA LINENO
 LDA VAL+1
 STA LINENO+1
 ORA VAL
 BEQ EDIT_SYNTAX
 LDA LINE,X
 BEQ EDIT_TEXT
 CMP #' '
 BNE EDIT_SYNTAX
EDIT_TEXT:
 JSR SPACES
EDIT_BUFFER:
 STX TEXT_POS
 SEC
 LDA LINE_LEN
 SBC TEXT_POS
 BEQ EDIT_DELETE
 CLC
 ADC #$04
EDIT_DELETE:
 STA NEWLEN
 STZ OLDLEN
 STZ PTR
 LDA #>SOURCE_START
 STA PTR+1
EDIT_FIND:
 JSR PTR_AT_END
 BEQ EDIT_CAPACITY
 LDY #$01
 LDA (PTR),Y
 CMP LINENO+1
 BCC EDIT_NEXT
 BNE EDIT_CAPACITY
 DEY
 LDA (PTR),Y
 CMP LINENO
 BCC EDIT_NEXT
 BNE EDIT_CAPACITY
 LDY #$02
 LDA (PTR),Y
 CLC
 ADC #$04
 STA OLDLEN
 BRA EDIT_CAPACITY
EDIT_NEXT:
 LDY #$02
 LDA (PTR),Y
 CLC
 ADC #$04
 JSR PTR_ADD
 BRA EDIT_FIND
EDIT_CAPACITY:
 SEC
 LDA SRC_END
 SBC OLDLEN
 STA TEMP
 LDA SRC_END+1
 SBC #$00
 STA TEMP+1
 CLC
 LDA TEMP
 ADC NEWLEN
 STA ENDPTR
 LDA TEMP+1
 ADC #$00
 STA ENDPTR+1
 CMP #>SOURCE_END
 BCC EDIT_REMOVE
 BNE EDIT_FULL
 LDA ENDPTR
 BNE EDIT_FULL
EDIT_REMOVE:
 ; Nothing has changed until all capacity checks have passed.
 STZ RESULT_VALID
 LDA PTR
 STA NEXT
 LDA PTR+1
 STA NEXT+1
 CLC
 LDA NEXT
 ADC OLDLEN
 STA NEXT
 BCC EDIT_REMOVE_PTR
 INC NEXT+1
EDIT_REMOVE_PTR:
 LDA PTR
 STA TEMP
 LDA PTR+1
 STA TEMP+1
EDIT_REMOVE_LOOP:
 LDA NEXT+1
 CMP SRC_END+1
 BNE EDIT_COPY_DOWN
 LDA NEXT
 CMP SRC_END
 BEQ EDIT_REMOVED
EDIT_COPY_DOWN:
 LDA (NEXT)
 STA (TEMP)
 INC NEXT
 BNE EDIT_NEXT_UP
 INC NEXT+1
EDIT_NEXT_UP:
 INC TEMP
 BNE EDIT_REMOVE_LOOP
 INC TEMP+1
 BRA EDIT_REMOVE_LOOP
EDIT_REMOVED:
 LDA TEMP
 STA SRC_END
 LDA TEMP+1
 STA SRC_END+1
 LDA NEWLEN
 BEQ EDIT_RETURN
 LDA ENDPTR
 STA NEXT
 LDA ENDPTR+1
 STA NEXT+1
EDIT_INSERT_LOOP:
 LDA TEMP+1
 CMP PTR+1
 BNE EDIT_COPY_UP
 LDA TEMP
 CMP PTR
 BEQ EDIT_INSERTED
EDIT_COPY_UP:
 JSR DEC_TEMP
 LDA NEXT
 BNE EDIT_DEC_NEXT
 DEC NEXT+1
EDIT_DEC_NEXT:
 DEC NEXT
 LDA (TEMP)
 STA (NEXT)
 BRA EDIT_INSERT_LOOP
EDIT_INSERTED:
 LDA ENDPTR
 STA SRC_END
 LDA ENDPTR+1
 STA SRC_END+1
 LDY #$00
 LDA LINENO
 STA (PTR),Y
 INY
 LDA LINENO+1
 STA (PTR),Y
 INY
 SEC
 LDA NEWLEN
 SBC #$04
 STA (PTR),Y
 INY
 LDA #$00
 STA (PTR),Y
 LDY #$04
 LDX TEXT_POS
EDIT_WRITE_TEXT:
 LDA LINE,X
 STA (PTR),Y
 INX
 INY
 CPX LINE_LEN
 BNE EDIT_WRITE_TEXT
EDIT_RETURN:
 RTS
EDIT_SYNTAX:
 LDA #E_SYNTAX
 STA ERROR
 RTS
EDIT_FULL:
 LDA #E_SOURCE
 STA ERROR
 RTS
PTR_AT_END:
 LDA PTR+1
 CMP SRC_END+1
 BNE PTR_END_RETURN
 LDA PTR
 CMP SRC_END
PTR_END_RETURN:
 RTS
PTR_ADD:
 CLC
 ADC PTR
 STA PTR
 BCC PTR_ADD_RETURN
 INC PTR+1
PTR_ADD_RETURN:
 RTS
DEC_TEMP:
 LDA TEMP
 BNE DEC_TEMP_LOW
 DEC TEMP+1
DEC_TEMP_LOW:
 DEC TEMP
 RTS

LIST_SOURCE:
 STZ REC
 LDA #>SOURCE_START
 STA REC+1
LIST_RECORD:
 JSR REC_AT_END
 BEQ LIST_DONE
 JSR LOAD_RECORD
 LDA ERROR
 BNE LIST_DONE
 LDA LINENO
 STA VAL
 LDA LINENO+1
 STA VAL+1
 JSR DECIMAL_OUT
 LDA #' '
 JSR PUTC
 LDX #$00
LIST_TEXT:
 LDA LINE,X
 BEQ LIST_LINE_END
 JSR PUTC
 INX
 BRA LIST_TEXT
LIST_LINE_END:
 JSR STR8V2_RAM_NEWLINE
 JSR NEXT_RECORD
 JSR STR8V2_RAM_CHECK_CANCEL
 BCC LIST_RECORD
LIST_DONE:
 RTS
REC_AT_END:
 LDA REC+1
 CMP SRC_END+1
 BNE REC_END_RETURN
 LDA REC
 CMP SRC_END
REC_END_RETURN:
 RTS
LOAD_RECORD:
 ; Validate a complete header and text span before any source fetch.
 CLC
 LDA REC
 ADC #$04
 STA NEXT
 LDA REC+1
 ADC #$00
 STA NEXT+1
 JSR CHECK_NEXT_BOUND
 BCS RECORD_BAD
 LDY #$00
 LDA (REC),Y
 STA LINENO
 INY
 LDA (REC),Y
 STA LINENO+1
 INY
 LDA (REC),Y
 STA LINE_LEN
 CMP #LINE_MAX+1
 BCS RECORD_BAD
 CLC
 ADC NEXT
 STA NEXT
 BCC RECORD_NEXT_OK
 INC NEXT+1
RECORD_NEXT_OK:
 JSR CHECK_NEXT_BOUND
 BCS RECORD_BAD
 LDX #$00
 LDY #$04
RECORD_COPY:
 CPX LINE_LEN
 BEQ RECORD_COPIED
 LDA (REC),Y
 STA LINE,X
 INX
 INY
 BRA RECORD_COPY
RECORD_COPIED:
 STZ LINE,X
 RTS
RECORD_BAD:
 LDA #E_SYNTAX
 STA ERROR
 RTS
CHECK_NEXT_BOUND:
 LDA NEXT+1
 CMP SRC_END+1
 BCC NEXT_BOUND_OK
 BNE NEXT_BOUND_BAD
 LDA NEXT
 CMP SRC_END
 BCC NEXT_BOUND_OK
 BEQ NEXT_BOUND_OK
NEXT_BOUND_BAD:
 SEC
 RTS
NEXT_BOUND_OK:
 CLC
 RTS
NEXT_RECORD:
 LDY #$02
 LDA (REC),Y
 CLC
 ADC #$04
 CLC
 ADC REC
 STA NEXT
 LDA REC+1
 ADC #$00
 STA NEXT+1
 LDA NEXT
 STA REC
 LDA NEXT+1
 STA REC+1
 RTS

; PASTE appends ordinary, unnumbered source in steps of ten. No per-character
; echo or per-line prompt: avoid filling the console RX queue during a paste.
PASTE_SOURCE:
 STZ REC
 LDA #>SOURCE_START
 STA REC+1
 STZ VAL
 STZ VAL+1
PASTE_FIND_LAST:
 JSR REC_AT_END
 BEQ PASTE_NUMBER
 LDY #$00
 LDA (REC),Y
 STA VAL
 INY
 LDA (REC),Y
 STA VAL+1
 JSR NEXT_RECORD
 BRA PASTE_FIND_LAST
PASTE_NUMBER:
 CLC
 LDA VAL
 ADC #$0A
 STA PASTE_NUM
 LDA VAL+1
 ADC #$00
 STA PASTE_NUM+1
 BCS PASTE_NUMBER_BAD
 LDX #<PASTE_TEXT
 LDY #>PASTE_TEXT
 JSR PRINT
 INC PASTE_MODE
 STZ PASTE_ERROR
PASTE_LINE:
 STZ ERROR
 LDA PASTE_NUM
 STA LINENO
 LDA PASTE_NUM+1
 STA LINENO+1
 JSR READ_LINE
 LDA ERROR
 CMP #E_CANCEL
 BEQ PASTE_CANCELLED
 LDA LINE
 CMP #'.'
 BNE PASTE_STORE
 LDA LINE+1
 BEQ PASTE_DONE
PASTE_STORE:
 LDA PASTE_ERROR
 BNE PASTE_LINE
 LDA ERROR
 BNE PASTE_SAVE_ERROR
 LDA LINE_LEN
 BEQ PASTE_LINE
 LDX #$00
 JSR EDIT_BUFFER
 LDA ERROR
 BNE PASTE_SAVE_ERROR
 CLC
 LDA PASTE_NUM
 ADC #$0A
 STA PASTE_NUM
 LDA PASTE_NUM+1
 ADC #$00
 STA PASTE_NUM+1
 BCC PASTE_LINE
 LDA #E_RANGE
 STA ERROR
PASTE_SAVE_ERROR:
 STA PASTE_ERROR
 LDA LINENO
 STA PASTE_ERROR_LINE
 LDA LINENO+1
 STA PASTE_ERROR_LINE+1
 BRA PASTE_LINE
PASTE_DONE:
 STZ PASTE_MODE
 JSR STR8V2_RAM_NEWLINE
 LDA PASTE_ERROR
 STA ERROR
 BEQ PASTE_RETURN
 LDA PASTE_ERROR_LINE
 STA LINENO
 LDA PASTE_ERROR_LINE+1
 STA LINENO+1
PASTE_RETURN:
 RTS
PASTE_CANCELLED:
 STZ PASTE_MODE
 JSR STR8V2_RAM_NEWLINE
 LDA #E_CANCEL
 STA ERROR
 RTS
PASTE_NUMBER_BAD:
 LDA #E_RANGE
 STA ERROR
 RTS
PASTE_TEXT: DB "Paste source; . ends, Ctrl-C cancels",$0D,$0A,0
