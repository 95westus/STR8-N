; Expressions: decimal/$hex/%binary/'c', symbols, current PC (*), parentheses,
; unary + - < > and binary + -. Arithmetic wraps at 16 bits; literals do not.
SPACES:
 LDA LINE,X
 CMP #' '
 BNE CAPS
 INX
 BRA SPACES
CAPS:
 CMP #'a'
 BCC CAPS_DONE
 CMP #'z'+1
 BCS CAPS_DONE
 AND #$DF
CAPS_DONE:
 ORA #$00
 RTS
END_LINE:
 LDA ERROR
 BNE END_LINE_OK
 JSR SPACES
 BEQ END_LINE_OK
 CMP #';'
 BEQ END_LINE_OK
 LDA #E_SYNTAX
 STA ERROR
END_LINE_OK:
 RTS
READ_TOKEN:
 STZ TOKEN_LOCAL
 LDY #$0F
 LDA #$00
TOKEN_CLEAR:
 STA TOKEN,Y
 DEY
 BPL TOKEN_CLEAR
 STZ TOK_LEN
 JSR SPACES
 JSR NAME_FIRST
 BCC TOKEN_BAD
TOKEN_LOOP:
 JSR CAPS
 JSR NAME_CHAR
 BCC TOKEN_DONE
 LDY TOK_LEN
 CPY #NAME_MAX
 BCS TOKEN_BAD
 STA TOKEN,Y
 INC TOK_LEN
 INX
 LDA LINE,X
 BRA TOKEN_LOOP
TOKEN_DONE:
 RTS
TOKEN_BAD:
 LDA #E_SYNTAX
 STA ERROR
 RTS
; The dot selects the current global-label scope. The stored name omits it,
; retaining the full 15-character name limit and 20-byte symbol rows.
READ_SYMBOL_TOKEN:
 JSR SPACES
 CMP #'.'
 BNE READ_TOKEN
 INX
 JSR READ_TOKEN
 LDA #$01
 STA TOKEN_LOCAL
 RTS
NAME_FIRST:
 CMP #'_'
 BEQ NAME_YES
 CMP #'A'
 BCC NAME_NO
 CMP #'Z'+1
 BCC NAME_YES
NAME_NO:
 CLC
 RTS
NAME_CHAR:
 CMP #'0'
 BCC NAME_FIRST
 CMP #'9'+1
 BCS NAME_FIRST
NAME_YES:
 SEC
 RTS

EXPRESSION:
 STZ UNRES
 STZ DEPTH
 JSR EXPR_SUM
 RTS
EXPR_SUM:
 JSR EXPR_UNARY
EXPR_SUM_NEXT:
 LDA ERROR
 BNE EXPR_RETURN
 JSR SPACES
 CMP #'+'
 BEQ EXPR_BINARY
 CMP #'-'
 BNE EXPR_RETURN
EXPR_BINARY:
 PHA
 LDA VAL
 PHA
 LDA VAL+1
 PHA
 INX
 JSR EXPR_UNARY
 PLA
 STA LEFT+1
 PLA
 STA LEFT
 PLA
 CMP #'+'
 BEQ EXPR_ADD
 SEC
 LDA LEFT
 SBC VAL
 STA VAL
 LDA LEFT+1
 SBC VAL+1
 STA VAL+1
 BRA EXPR_SUM_NEXT
EXPR_ADD:
 CLC
 LDA LEFT
 ADC VAL
 STA VAL
 LDA LEFT+1
 ADC VAL+1
 STA VAL+1
 BRA EXPR_SUM_NEXT
EXPR_RETURN:
 RTS
EXPR_UNARY:
 INC DEPTH
 LDA DEPTH
 CMP #$09
 BCS EXPR_TOO_DEEP
 JSR SPACES
 CMP #'+'
 BEQ EXPR_PREFIX
 CMP #'-'
 BEQ EXPR_PREFIX
 CMP #'<'
 BEQ EXPR_PREFIX
 CMP #'>'
 BEQ EXPR_PREFIX
 CMP #'('
 BEQ EXPR_GROUP
 JSR EXPR_PRIMARY
 BRA EXPR_UNARY_DONE
EXPR_PREFIX:
 PHA
 INX
 JSR EXPR_UNARY
 PLA
 CMP #'+'
 BEQ EXPR_UNARY_DONE
 CMP #'<'
 BEQ EXPR_LOW
 CMP #'>'
 BEQ EXPR_HIGH
 SEC
 LDA #$00
 SBC VAL
 STA VAL
 LDA #$00
 SBC VAL+1
 STA VAL+1
 BRA EXPR_UNARY_DONE
EXPR_LOW:
 STZ VAL+1
 BRA EXPR_UNARY_DONE
EXPR_HIGH:
 LDA VAL+1
 STA VAL
 STZ VAL+1
 BRA EXPR_UNARY_DONE
EXPR_GROUP:
 INX
 JSR EXPR_SUM
 LDA ERROR
 BNE EXPR_UNARY_DONE
 JSR SPACES
 CMP #')'
 BNE EXPR_SYNTAX
 INX
EXPR_UNARY_DONE:
 DEC DEPTH
 RTS
EXPR_TOO_DEEP:
 LDA #E_DEPTH
 STA ERROR
 BRA EXPR_UNARY_DONE
EXPR_SYNTAX:
 LDA #E_SYNTAX
 STA ERROR
 BRA EXPR_UNARY_DONE
EXPR_PRIMARY:
 STZ VAL
 STZ VAL+1
 JSR SPACES
 CMP #'$'
 BEQ EXPR_HEX
 CMP #'%'
 BEQ EXPR_BINARY_NUMBER
 CMP #$27
 BEQ EXPR_CHARACTER
 CMP #'*'
 BEQ EXPR_PC
 CMP #'0'
 BCC EXPR_SYMBOL
 CMP #'9'+1
 BCS EXPR_SYMBOL
 LDA #$0A
 STA RADIX
 JMP READ_NUMBER
EXPR_HEX:
 LDA #$10
 BRA EXPR_NUMBER_PREFIX
EXPR_BINARY_NUMBER:
 LDA #$02
EXPR_NUMBER_PREFIX:
 STA RADIX
 INX
 JMP READ_NUMBER
EXPR_CHARACTER:
 INX
 LDA LINE,X
 BEQ EXPR_PRIMARY_BAD
 STA VAL
 INX
 LDA LINE,X
 CMP #$27
 BNE EXPR_PRIMARY_BAD
 INX
 RTS
EXPR_PC:
 LDA PC
 STA VAL
 LDA PC+1
 STA VAL+1
 INX
 RTS
EXPR_SYMBOL:
 JSR READ_SYMBOL_TOKEN
 LDA ERROR
 BNE EXPR_PRIMARY_RETURN
 JSR FIND_SYMBOL
 LDA ERROR
 BNE EXPR_PRIMARY_RETURN
 LDY #$12
 LDA (SYMPTR),Y
 AND #$01
 BEQ SYMBOL_UNDEFINED
 LDY #$10
 LDA (SYMPTR),Y
 STA VAL
 INY
 LDA (SYMPTR),Y
 STA VAL+1
EXPR_PRIMARY_RETURN:
 RTS
SYMBOL_UNDEFINED:
 INC UNRES
 LDA PASS
 CMP #$02
 BNE EXPR_PRIMARY_RETURN
 LDA #E_UNDEFINED
 STA ERROR
 RTS
EXPR_PRIMARY_BAD:
 LDA #E_SYNTAX
 STA ERROR
 RTS

READ_NUMBER:
 STZ VAL
 STZ VAL+1
 STZ POS
NUMBER_LOOP:
 LDA LINE,X
 JSR CAPS
 JSR HEX_DIGIT
 BCC NUMBER_DONE
 CMP RADIX
 BCS NUMBER_DONE
 STA DIGIT
 LDA VAL
 STA NUMBER
 LDA VAL+1
 STA NUMBER+1
 STZ VAL
 STZ VAL+1
 LDY RADIX
NUMBER_MULTIPLY:
 CLC
 LDA VAL
 ADC NUMBER
 STA VAL
 LDA VAL+1
 ADC NUMBER+1
 STA VAL+1
 BCS NUMBER_OVERFLOW
 DEY
 BNE NUMBER_MULTIPLY
 CLC
 LDA VAL
 ADC DIGIT
 STA VAL
 BCC NUMBER_DIGIT_OK
 INC VAL+1
 BEQ NUMBER_OVERFLOW
NUMBER_DIGIT_OK:
 INX
 INC POS
 BRA NUMBER_LOOP
NUMBER_DONE:
 LDA POS
 BNE NUMBER_RETURN
 LDA #E_SYNTAX
 STA ERROR
NUMBER_RETURN:
 RTS
NUMBER_OVERFLOW:
 LDA #E_RANGE
 STA ERROR
 RTS
HEX_DIGIT:
 CMP #'0'
 BCC HEX_NO
 CMP #'9'+1
 BCC HEX_DECIMAL
 CMP #'A'
 BCC HEX_NO
 CMP #'F'+1
 BCS HEX_NO
 SEC
 SBC #'A'-10
 SEC
 RTS
HEX_DECIMAL:
 SEC
 SBC #'0'
 SEC
 RTS
HEX_NO:
 CLC
 RTS

; 256 records of 20 bytes: name[16], value[2], flags, parent symbol index.
; Flags bit 0=defined, bit 7=local. Globals and locals have distinct identities.
; References create an undefined entry in pass 1; pass 2 never creates one.
FIND_SYMBOL:
 LDA TOKEN_LOCAL
 BEQ SYMBOL_SCOPE_OK
 LDA SCOPE_VALID
 BNE SYMBOL_SCOPE_OK
 LDA #E_SCOPE
 STA ERROR
 RTS
SYMBOL_SCOPE_OK:
 STZ SYMBOL_INDEX
 STZ SYMPTR
 LDA #>SYMBOL_START
 STA SYMPTR+1
SYMBOL_SEARCH:
 LDA SYMPTR+1
 CMP SYMTOP+1
 BNE SYMBOL_COMPARE
 LDA SYMPTR
 CMP SYMTOP
 BEQ SYMBOL_CREATE
SYMBOL_COMPARE:
 LDY #$12
 LDA (SYMPTR),Y
 AND #$80
 BEQ SYMBOL_GLOBAL
 LDA TOKEN_LOCAL
 BEQ SYMBOL_NEXT
 INY
 LDA (SYMPTR),Y
 CMP SCOPE_ID
 BNE SYMBOL_NEXT
 BRA SYMBOL_NAME_START
SYMBOL_GLOBAL:
 LDA TOKEN_LOCAL
 BNE SYMBOL_NEXT
SYMBOL_NAME_START:
 LDY #$00
SYMBOL_NAME_COMPARE:
 LDA (SYMPTR),Y
 CMP TOKEN,Y
 BNE SYMBOL_NEXT
 CMP #$00
 BEQ SYMBOL_FOUND
 INY
 BRA SYMBOL_NAME_COMPARE
SYMBOL_NEXT:
 INC SYMBOL_INDEX
 CLC
 LDA SYMPTR
 ADC #$14
 STA SYMPTR
 BCC SYMBOL_SEARCH
 INC SYMPTR+1
 BRA SYMBOL_SEARCH
SYMBOL_CREATE:
 LDA PASS
 CMP #$02
 BEQ SYMBOL_NOT_FOUND
 LDA SYMTOP+1
 CMP #>SYMBOL_END
 BCS SYMBOL_FULL
 LDY #$13
 LDA #$00
SYMBOL_ZERO:
 STA (SYMPTR),Y
 DEY
 BPL SYMBOL_ZERO
 LDA TOKEN_LOCAL
 BEQ SYMBOL_COPY_GLOBAL
 LDY #$12
 LDA #$80
 STA (SYMPTR),Y
 INY
 LDA SCOPE_ID
 STA (SYMPTR),Y
SYMBOL_COPY_GLOBAL:
 LDY #$00
SYMBOL_COPY_NAME:
 LDA TOKEN,Y
 STA (SYMPTR),Y
 BEQ SYMBOL_CREATED
 INY
 BRA SYMBOL_COPY_NAME
SYMBOL_CREATED:
 CLC
 LDA SYMTOP
 ADC #$14
 STA SYMTOP
 BCC SYMBOL_FOUND
 INC SYMTOP+1
SYMBOL_FOUND:
 RTS
SYMBOL_NOT_FOUND:
 LDA #E_UNDEFINED
 STA ERROR
 RTS
SYMBOL_FULL:
 LDA #E_SYMBOLS
 STA ERROR
 RTS
