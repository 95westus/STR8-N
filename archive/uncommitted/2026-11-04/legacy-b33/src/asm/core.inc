; Callable engine: source records in SOURCE_START..SRC_END, no console input.
; C=0 success (RESULT_VALID=1); C=1 error (ERROR, LINENO identify failure).
ASM_ASSEMBLE:
 STZ RESULT_VALID
 STZ RESULT_LEN
 STZ RESULT_LEN+1
 STZ ERROR
 STZ LINENO
 STZ LINENO+1
 STZ SYMTOP
 LDA #>SYMBOL_START
 STA SYMTOP+1
 LDA #$01
 STA PASS
 LDA SRC_END+1
 CMP #>SOURCE_START
 BCC ASSEMBLE_SOURCE_BAD
 CMP #>SOURCE_END
 BCC ASSEMBLE_PASS
 BNE ASSEMBLE_SOURCE_BAD
 LDA SRC_END
 BNE ASSEMBLE_SOURCE_BAD
ASSEMBLE_PASS:
 STZ SCOPE_ID
 STZ SCOPE_VALID
 STZ BASESET
 STZ PCFULL
 STZ ASSEMBLY_END
 STZ PC
 STZ OUTPTR
 LDA #>OUTPUT_START
 STA PC+1
 STA OUTPTR+1
 STZ REC
 LDA #>SOURCE_START
 STA REC+1
ASSEMBLE_RECORD:
 JSR REC_AT_END
 BEQ ASSEMBLE_PASS_DONE
 JSR LOAD_RECORD
 LDA ERROR
 BNE ASSEMBLE_FAILED
 JSR ASSEMBLE_LINE
 LDA ERROR
 BNE ASSEMBLE_FAILED
 LDA ASSEMBLY_END
 BNE ASSEMBLE_PASS_DONE
 JSR STR8V2_RAM_CHECK_CANCEL
 BCS ASSEMBLE_CANCEL
 JSR NEXT_RECORD
 BRA ASSEMBLE_RECORD
ASSEMBLE_PASS_DONE:
 LDA PASS
 CMP #$02
 BEQ ASSEMBLE_SUCCESS
 INC PASS
 BRA ASSEMBLE_PASS
ASSEMBLE_SUCCESS:
 LDA BASESET
 BNE ASSEMBLE_RESULT
 LDA PC
 STA RESULT_ORIGIN
 LDA PC+1
 STA RESULT_ORIGIN+1
ASSEMBLE_RESULT:
 LDA OUTPTR
 STA RESULT_LEN
 SEC
 LDA OUTPTR+1
 SBC #>OUTPUT_START
 STA RESULT_LEN+1
 LDA #$01
 STA RESULT_VALID
 CLC
 RTS
ASSEMBLE_SOURCE_BAD:
 LDA #E_SOURCE
 STA ERROR
 BRA ASSEMBLE_FAILED
ASSEMBLE_CANCEL:
 LDA #E_CANCEL
 STA ERROR
ASSEMBLE_FAILED:
 SEC
 RTS

ASSEMBLE_LINE:
 LDX #$00
 JSR SPACES
 BEQ CORE_RETURN
 CMP #';'
 BEQ CORE_RETURN
CORE_FIRST_TOKEN:
 JSR READ_SYMBOL_TOKEN
 LDA ERROR
 BNE CORE_RETURN
 JSR SPACES
 CMP #':'
 BEQ CORE_LABEL
 CMP #'='
 BEQ CORE_CONSTANT
 BRA CORE_COMMAND
CORE_LABEL:
 JSR FIND_SYMBOL
 LDA ERROR
 BNE CORE_RETURN
 LDA PC
 STA VAL
 LDA PC+1
 STA VAL+1
 JSR DEFINE_SYMBOL
 LDA ERROR
 BNE CORE_RETURN
 LDA TOKEN_LOCAL
 BNE CORE_LABEL_SCOPED
 LDA SYMBOL_INDEX
 STA SCOPE_ID
 LDA #$01
 STA SCOPE_VALID
CORE_LABEL_SCOPED:
 INX
 JSR SPACES
 BEQ CORE_RETURN
 CMP #';'
 BEQ CORE_RETURN
 CMP #'.'
 BNE CORE_LABEL_COMMAND
 INX
CORE_LABEL_COMMAND:
 JSR READ_TOKEN
 LDA ERROR
 BNE CORE_RETURN
 BRA CORE_COMMAND
CORE_CONSTANT:
 JSR FIND_SYMBOL
 LDA ERROR
 BNE CORE_RETURN
 LDA SYMPTR
 STA DEF_PTR
 LDA SYMPTR+1
 STA DEF_PTR+1
 INX
 JSR EXPRESSION
 LDA UNRES
 BNE CORE_LAYOUT_BAD
 JSR END_LINE
 LDA ERROR
 BNE CORE_RETURN
 LDA DEF_PTR
 STA SYMPTR
 LDA DEF_PTR+1
 STA SYMPTR+1
 JMP DEFINE_SYMBOL
CORE_COMMAND:
 STX OPPOS
 LDA TOKEN
 CMP #'O'
 BNE CORE_NOT_ORG
 PHX
 LDX #<DIR_ORG
 LDY #>DIR_ORG
 JSR MATCH_TOKEN
 PLX
 BCS CORE_ORG
CORE_NOT_ORG:
 LDA TOKEN
 CMP #'B'
 BNE CORE_NOT_BYTE
 PHX
 LDX #<DIR_BYTE
 LDY #>DIR_BYTE
 JSR MATCH_TOKEN
 PLX
 BCS CORE_BYTE
CORE_NOT_BYTE:
 LDA TOKEN
 CMP #'W'
 BNE CORE_NOT_WORD
 PHX
 LDX #<DIR_WORD
 LDY #>DIR_WORD
 JSR MATCH_TOKEN
 PLX
 BCS CORE_WORD
CORE_NOT_WORD:
 LDA TOKEN
 CMP #'T'
 BNE CORE_NOT_TEXT
 PHX
 LDX #<DIR_TEXT
 LDY #>DIR_TEXT
 JSR MATCH_TOKEN
 PLX
 BCS CORE_BYTE
CORE_NOT_TEXT:
 LDA TOKEN
 CMP #'F'
 BNE CORE_NOT_FILL
 PHX
 LDX #<DIR_FILL
 LDY #>DIR_FILL
 JSR MATCH_TOKEN
 PLX
 BCS CORE_FILL
CORE_NOT_FILL:
 LDA TOKEN
 CMP #'E'
 BNE CORE_INSTRUCTION
 PHX
 LDX #<DIR_END
 LDY #>DIR_END
 JSR MATCH_TOKEN
 PLX
 BCC CORE_INSTRUCTION
 JSR END_LINE
 INC ASSEMBLY_END
CORE_RETURN:
 RTS
CORE_LAYOUT_BAD:
 LDA #E_LAYOUT
 STA ERROR
 RTS
CORE_SYNTAX:
 LDA #E_SYNTAX
 STA ERROR
 RTS
CORE_RANGE:
 LDA #E_RANGE
 STA ERROR
 RTS

DEFINE_SYMBOL:
 LDY #$12
 LDA PASS
 CMP #$02
 BEQ DEFINE_COMPARE
 LDA (SYMPTR),Y
 AND #$01
 BNE DEFINE_DUPLICATE
 LDA (SYMPTR),Y
 ORA #$01
 STA (SYMPTR),Y
 LDY #$10
 LDA VAL
 STA (SYMPTR),Y
 INY
 LDA VAL+1
 STA (SYMPTR),Y
 RTS
DEFINE_COMPARE:
 LDA (SYMPTR),Y
 AND #$01
 BEQ DEFINE_PHASE
 LDY #$10
 LDA (SYMPTR),Y
 CMP VAL
 BNE DEFINE_PHASE
 INY
 LDA (SYMPTR),Y
 CMP VAL+1
 BNE DEFINE_PHASE
 RTS
DEFINE_DUPLICATE:
 LDA #E_DUPLICATE
 STA ERROR
 RTS
DEFINE_PHASE:
 LDA #E_PHASE
 STA ERROR
 RTS

CORE_ORG:
 JSR EXPRESSION
 LDA ERROR
 BNE CORE_RETURN
 LDA UNRES
 BNE CORE_LAYOUT_BAD
 ; Preserve the target while an optional byte expression uses VAL.
 LDA VAL
 STA COUNT
 LDA VAL+1
 STA COUNT+1
 STZ OPERAND
 JSR SPACES
 CMP #','
 BNE ORG_END
 INX
 JSR EXPRESSION
 JSR BYTE_VALUE
 LDA ERROR
 BNE CORE_RETURN
 LDA VAL
 STA OPERAND
ORG_END:
 JSR END_LINE
 LDA ERROR
 BNE CORE_RETURN
 LDA BASESET
 BNE ORG_GAP
 LDA COUNT
 STA PC
 LDA COUNT+1
 STA PC+1
 RTS
ORG_GAP:
 LDA PCFULL
 BNE CORE_RANGE
 SEC
 LDA COUNT
 SBC PC
 STA COUNT
 LDA COUNT+1
 SBC PC+1
 STA COUNT+1
 BCC CORE_RANGE
 JMP FILL_LOOP
CORE_FILL:
 JSR EXPRESSION
 LDA ERROR
 BNE CORE_RETURN
 LDA UNRES
 BNE CORE_LAYOUT_BAD
 LDA VAL
 STA COUNT
 LDA VAL+1
 STA COUNT+1
 JSR SPACES
 CMP #','
 BNE CORE_SYNTAX
 INX
 JSR EXPRESSION
 JSR END_LINE
 JSR BYTE_VALUE
 LDA ERROR
 BNE CORE_RETURN
 LDA VAL
 STA OPERAND
FILL_LOOP:
 LDA COUNT
 ORA COUNT+1
 BEQ CORE_RETURN
 LDA OPERAND
 JSR EMIT_BYTE
 LDA ERROR
 BNE CORE_RETURN
 LDA COUNT
 BNE FILL_DEC
 DEC COUNT+1
FILL_DEC:
 DEC COUNT
 BRA FILL_LOOP
CORE_BYTE:
 LDA #$01
 BRA CORE_DATA
CORE_WORD:
 LDA #$02
CORE_DATA:
 STA DATA_KIND
DATA_ITEM:
 JSR SPACES
 CMP #'"'
 BEQ DATA_STRING
 JSR EXPRESSION
 LDA DATA_KIND
 CMP #$01
 BNE DATA_WORD
 JSR BYTE_VALUE
DATA_WORD:
 LDA ERROR
 BNE CORE_RETURN
 LDA VAL
 JSR EMIT_BYTE
 LDA DATA_KIND
 CMP #$02
 BNE DATA_NEXT
 LDA VAL+1
 JSR EMIT_BYTE
DATA_NEXT:
 LDA ERROR
 BNE CORE_RETURN
 JSR SPACES
 CMP #','
 BNE DATA_FINISH
 INX
 BRA DATA_ITEM
DATA_FINISH:
 JMP END_LINE
DATA_STRING:
 LDA DATA_KIND
 CMP #$01
 BNE CORE_SYNTAX
 INX
DATA_STRING_CHAR:
 LDA LINE,X
 BEQ CORE_SYNTAX
 CMP #'"'
 BEQ DATA_STRING_END
 CMP #$5C
 BNE DATA_STRING_EMIT
 INX
 LDA LINE,X
 CMP #'n'
 BEQ DATA_ESCAPE_LF
 CMP #'r'
 BEQ DATA_ESCAPE_CR
 CMP #'t'
 BEQ DATA_ESCAPE_TAB
 CMP #'0'
 BEQ DATA_ESCAPE_ZERO
 CMP #'"'
 BEQ DATA_STRING_EMIT
 CMP #$5C
 BNE CORE_SYNTAX
 BRA DATA_STRING_EMIT
DATA_ESCAPE_LF:
 LDA #$0A
 BRA DATA_STRING_EMIT
DATA_ESCAPE_CR:
 LDA #$0D
 BRA DATA_STRING_EMIT
DATA_ESCAPE_TAB:
 LDA #$09
 BRA DATA_STRING_EMIT
DATA_ESCAPE_ZERO:
 LDA #$00
DATA_STRING_EMIT:
 JSR EMIT_BYTE
 LDA ERROR
 BNE CORE_RETURN
 INX
 BRA DATA_STRING_CHAR
DATA_STRING_END:
 INX
 BRA DATA_NEXT

CORE_INSTRUCTION:
 LDA TOK_LEN
 CMP #$05
 BCS INSTRUCTION_BAD
 LDY #$03
COPY_OPCODE_NAME:
 LDA TOKEN,Y
 STA OP_TOKEN,Y
 DEY
 BPL COPY_OPCODE_NAME
 LDA #$FF
 STA WANT
 JSR LOOKUP_OPCODE
 BCC INSTRUCTION_BAD
 LDA MODE
 CMP #$0E
 BEQ INSTRUCTION_BRANCH
 CMP #$0F
 BEQ INSTRUCTION_BIT_BRANCH
 JSR SPACES
 BEQ INSTRUCTION_IMPLIED
 CMP #';'
 BEQ INSTRUCTION_IMPLIED
 CMP #'A'
 BNE INSTRUCTION_OPERAND
 LDA LINE+1,X
 BEQ INSTRUCTION_ACC
 CMP #';'
 BEQ INSTRUCTION_ACC
 CMP #' '
 BNE INSTRUCTION_OPERAND
INSTRUCTION_ACC:
 LDA #$01
 STA WANT
 JSR LOOKUP_OPCODE
 BCC INSTRUCTION_OPERAND
 INX
 JSR END_LINE
 JMP EMIT_INSTRUCTION
INSTRUCTION_IMPLIED:
 STZ WANT
 JSR LOOKUP_OPCODE
 BCS EMIT_INSTRUCTION
 LDA #$01
 STA WANT
 JSR LOOKUP_OPCODE
 BCC INSTRUCTION_BAD
 JMP EMIT_INSTRUCTION
INSTRUCTION_OPERAND:
 JSR SPACES
 CMP #'#'
 BEQ INSTRUCTION_IMMEDIATE
 CMP #'('
 BEQ INSTRUCTION_INDIRECT
 STZ FORCE_ZP
 CMP #'<'
 BNE INSTRUCTION_DIRECT
 INC FORCE_ZP
INSTRUCTION_DIRECT:
 LDA #$06
 STA WANT
 JSR EXPRESSION
 JSR SPACES
 CMP #','
 BNE INSTRUCTION_SELECT
 INX
 JSR SPACES
 CMP #'X'
 BEQ INSTRUCTION_X
 CMP #'Y'
 BNE CORE_SYNTAX
 LDA #$08
 BRA INSTRUCTION_INDEX
INSTRUCTION_X:
 LDA #$07
INSTRUCTION_INDEX:
 STA WANT
 INX
INSTRUCTION_SELECT:
 JSR END_LINE
 LDA ERROR
 BNE CORE_RETURN
 LDA PASS
 CMP #$02
 BEQ INSTRUCTION_REUSE
 LDA VAL+1
 BNE INSTRUCTION_LOOKUP
 LDA UNRES
 BEQ INSTRUCTION_TRY_ZP
 LDA FORCE_ZP
 BEQ INSTRUCTION_LOOKUP
INSTRUCTION_TRY_ZP:
 LDA WANT
 PHA
 SEC
 SBC #$03
 STA WANT
 JSR LOOKUP_OPCODE
 BCC INSTRUCTION_NO_ZP
 PLA
 BRA INSTRUCTION_SAVE
INSTRUCTION_NO_ZP:
 PLA
 STA WANT
INSTRUCTION_LOOKUP:
 JSR LOOKUP_OPCODE
 BCS INSTRUCTION_SAVE
 ; Some forms exist only in zero page (RMB/SMB, STX zp,Y, STY zp,X).
 ; Reserve that fixed width for a forward reference, then range-check pass 2.
 LDA WANT
 CMP #$06
 BCC INSTRUCTION_BAD
 CMP #$09
 BCS INSTRUCTION_BAD
 SEC
 SBC #$03
 STA WANT
 JSR LOOKUP_OPCODE
 BCC INSTRUCTION_BAD
 BRA INSTRUCTION_SAVE
INSTRUCTION_REUSE:
 LDY #$03
 LDA (REC),Y
 STA WANT
 JSR LOOKUP_OPCODE
 BCC INSTRUCTION_BAD
 BRA INSTRUCTION_ENCODE
INSTRUCTION_SAVE:
 LDY #$03
 LDA MODE
 STA (REC),Y
INSTRUCTION_ENCODE:
 LDA MODE
 CMP #$06
 BCC INSTRUCTION_BYTE
 CMP #$09
 BCC INSTRUCTION_WORD
 CMP #$0C
 BCC INSTRUCTION_ZP
 BRA INSTRUCTION_WORD
INSTRUCTION_BYTE:
 CMP #$02
 BNE INSTRUCTION_ZP
 JSR BYTE_VALUE
 BRA INSTRUCTION_WORD
INSTRUCTION_ZP:
 LDA UNRES
 BNE INSTRUCTION_WORD
 LDA VAL+1
 BNE CORE_RANGE
INSTRUCTION_WORD:
 LDA VAL
 STA OPERAND
 LDA VAL+1
 STA OPERAND+1
 JMP EMIT_INSTRUCTION
INSTRUCTION_IMMEDIATE:
 LDA #$02
 STA WANT
 INX
 JSR EXPRESSION
 JSR END_LINE
 JMP INSTRUCTION_LOOKUP
INSTRUCTION_INDIRECT:
 INX
 JSR EXPRESSION
 JSR SPACES
 CMP #','
 BEQ INSTRUCTION_IND_X
 CMP #')'
 BNE CORE_SYNTAX
 INX
 JSR SPACES
 CMP #','
 BEQ INSTRUCTION_IND_Y
 LDA #$0B
 STA WANT
 JSR LOOKUP_OPCODE
 BCS INSTRUCTION_IND_DONE
 LDA #$0C
 STA WANT
 BRA INSTRUCTION_IND_DONE
INSTRUCTION_IND_X:
 INX
 JSR SPACES
 CMP #'X'
 BNE CORE_SYNTAX
 INX
 JSR SPACES
 CMP #')'
 BNE CORE_SYNTAX
 INX
 LDA #$09
 STA WANT
 JSR LOOKUP_OPCODE
 BCS INSTRUCTION_IND_DONE
 LDA #$0D
 STA WANT
 BRA INSTRUCTION_IND_DONE
INSTRUCTION_IND_Y:
 INX
 JSR SPACES
 CMP #'Y'
 BNE CORE_SYNTAX
 INX
 LDA #$0A
 STA WANT
INSTRUCTION_IND_DONE:
 JSR END_LINE
 JMP INSTRUCTION_LOOKUP
INSTRUCTION_BRANCH:
 JSR EXPRESSION
 JSR END_LINE
 LDA #$0E
 STA WANT
 JSR LOOKUP_OPCODE
 LDA #$02
 JSR BRANCH_VALUE
 LDA VAL
 STA OPERAND
 JMP EMIT_INSTRUCTION
INSTRUCTION_BIT_BRANCH:
 JSR EXPRESSION
 LDA ERROR
 BNE CORE_RETURN
 LDA UNRES
 BNE BIT_BRANCH_ZP_OK
 LDA VAL+1
 BNE CORE_RANGE
BIT_BRANCH_ZP_OK:
 LDA VAL
 STA BIT_ZP
 JSR SPACES
 CMP #','
 BNE CORE_SYNTAX
 INX
 JSR EXPRESSION
 JSR END_LINE
 LDA #$0F
 STA WANT
 JSR LOOKUP_OPCODE
 LDA #$03
 JSR BRANCH_VALUE
 LDA VAL
 STA OPERAND+1
 LDA BIT_ZP
 STA OPERAND
 JMP EMIT_INSTRUCTION
INSTRUCTION_BAD:
 LDA #E_OPCODE
 STA ERROR
 RTS
BRANCH_VALUE:
 LDY ERROR
 BNE BRANCH_RETURN
 CLC
 ADC PC
 STA RIGHT
 LDA PC+1
 ADC #$00
 STA RIGHT+1
 SEC
 LDA VAL
 SBC RIGHT
 STA VAL
 LDA VAL+1
 SBC RIGHT+1
 STA VAL+1
 LDA PASS
 CMP #$01
 BEQ BRANCH_RETURN
 LDA VAL+1
 BEQ BRANCH_POSITIVE
 CMP #$FF
 BNE BRANCH_BAD
 LDA VAL
 CMP #$80
 BCS BRANCH_RETURN
 BRA BRANCH_BAD
BRANCH_POSITIVE:
 LDA VAL
 CMP #$80
 BCC BRANCH_RETURN
BRANCH_BAD:
 LDA #E_BRANCH
 STA ERROR
BRANCH_RETURN:
 RTS
BYTE_VALUE:
 LDA ERROR
 BNE BYTE_VALUE_RETURN
 LDA UNRES
 BNE BYTE_VALUE_RETURN
 LDA VAL+1
 BEQ BYTE_VALUE_RETURN
 CMP #$FF
 BNE CORE_RANGE
 LDA VAL
 CMP #$80
 BCC CORE_RANGE
BYTE_VALUE_RETURN:
 RTS

LOOKUP_OPCODE:
 PHX
 LDA #<OP_TABLE
 STA TABLEPTR
 LDA #>OP_TABLE
 STA TABLEPTR+1
LOOKUP_ROW:
 LDA TABLEPTR+1
 CMP #>OP_END
 BNE LOOKUP_COMPARE
 LDA TABLEPTR
 CMP #<OP_END
 BEQ LOOKUP_MISSING
LOOKUP_COMPARE:
 LDY #$00
LOOKUP_NAME:
 LDA (TABLEPTR),Y
 CMP OP_TOKEN,Y
 BNE LOOKUP_NEXT
 INY
 CPY #$04
 BNE LOOKUP_NAME
 LDA WANT
 CMP #$FF
 BEQ LOOKUP_FOUND
 CMP (TABLEPTR),Y
 BEQ LOOKUP_FOUND
LOOKUP_NEXT:
 CLC
 LDA TABLEPTR
 ADC #$06
 STA TABLEPTR
 BCC LOOKUP_ROW
 INC TABLEPTR+1
 BRA LOOKUP_ROW
LOOKUP_FOUND:
 LDA (TABLEPTR),Y
 STA MODE
 INY
 LDA (TABLEPTR),Y
 STA OPCODE
 PLX
 SEC
 RTS
LOOKUP_MISSING:
 PLX
 CLC
 RTS

EMIT_INSTRUCTION:
 LDA ERROR
 BNE EMIT_RETURN
 LDA OPCODE
 JSR EMIT_BYTE
 LDA OPCODE
 BNE EMIT_STANDARD_LENGTH
 ; BRK consumes its signature byte; bare BRK emits a zero signature.
 LDA #$00
 JMP EMIT_BYTE
EMIT_STANDARD_LENGTH:
 LDY MODE
 LDA MODE_LENGTHS,Y
 CMP #$01
 BEQ EMIT_RETURN
 LDA OPERAND
 JSR EMIT_BYTE
 LDY MODE
 LDA MODE_LENGTHS,Y
 CMP #$03
 BNE EMIT_RETURN
 LDA OPERAND+1
 JMP EMIT_BYTE
EMIT_BYTE:
 PHA
 LDA ERROR
 BNE EMIT_POP
 LDA PCFULL
 BNE EMIT_RANGE
 LDA OUTPTR+1
 CMP #>OUTPUT_END
 BCS EMIT_FULL
 LDA BASESET
 BNE EMIT_READY
 LDA PC
 STA RESULT_ORIGIN
 LDA PC+1
 STA RESULT_ORIGIN+1
 INC BASESET
EMIT_READY:
 PLA
 PHA
 LDY PASS
 CPY #$02
 BNE EMIT_ADVANCE
 STA (OUTPTR)
EMIT_ADVANCE:
 INC OUTPTR
 BNE EMIT_PC
 INC OUTPTR+1
EMIT_PC:
 INC PC
 BNE EMIT_POP
 INC PC+1
 BNE EMIT_POP
 INC PCFULL
EMIT_POP:
 PLA
EMIT_RETURN:
 RTS
EMIT_RANGE:
 LDA #E_RANGE
 STA ERROR
 BRA EMIT_POP
EMIT_FULL:
 LDA #E_OUTPUT
 STA ERROR
 BRA EMIT_POP
MODE_LENGTHS:
 DB 1,1,2,2,2,2,3,3,3,2,2,2,3,3,2,3
DIR_ORG: DB "ORG",0
DIR_BYTE: DB "BYTE",0
DIR_WORD: DB "WORD",0
DIR_TEXT: DB "TEXT",0
DIR_FILL: DB "FILL",0
DIR_END: DB "END",0
