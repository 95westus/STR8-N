; Four 32-byte slots in ordinary EEPROM 00-7F; factory/status excluded.
J_EE_BASE EQU 0
J_SLOTS EQU 4
J_CACHE EQU $6B00
J_RECORD EQU $6B80
J_VERIFY EQU $6BA0
J_PACKET EQU $6BC0
J_OP EQU $6BD0
J_RESULT EQU $6BD1
J_SLOT EQU $6BD2
J_SCAN_SLOT EQU $6BD3
J_VALID EQU $6BD4
J_PENDING EQU $6BD5
J_NEXT EQU $6BD6
J_LATEST EQU $6BD7
J_OLDEST EQU $6BD8
J_SEQUENCE EQU $6BD9
J_CRC EQU $6BDD
J_INDEX EQU $6BDF
EE_PTR EQU $6BE0
EE_ADDR EQU $6BE2
EE_COUNT EQU $6BE3
EE_WRITE EQU $6BE4
EE_RESULT EQU $6BE5
J_PARAM EQU $6BE6
J_KEY EQU $6BE7
J_MATCH EQU $6BE9
J_OFFSET EQU $6BEA
J_COUNT EQU $6BEB
J_TMP EQU $6BEC
J_MASK EQU $6BED
J_OUTCOME EQU $6BEE       ; bit 0: committed record verified; bit 1: ACK verified
J_POLL EQU $6BEF
J_DESC EQU $7D19
J_LOCK EQU $7D22
J_SCAN_OP EQU 0
J_SAVE_ACK_OP EQU 1
J_CLEAR_OP EQU 2
J_CLEAR_ALL_OP EQU 3
J_SAVE_OP EQU 4
J_RECONCILE_OP EQU 5
J_EUI_OP EQU 6
J_EUI EQU $6BA0              ; six read-only identity bytes, transient workspace
J_BIND_CHECK_OP EQU 7
J_BIND_ACCEPT_OP EQU 8
J_BIND_STATUS EQU $6BF0      ; 0 unbound, 1 match, 2 changed, 3 current unavailable
J_CURRENT_VALID EQU $6BF1
J_REMEMBERED EQU $6BF2       ; six remembered identity bytes
J_BIND_REQUEST EQU $6B80     ; six identity bytes explicitly accepted by caller
J_BIND_FULL EQU $93
J_BIND_WRITE_FAILED EQU $94
J_BIND_PRINT_OP EQU 9
J_FOREIGN EQU $90
J_VERIFY_FAILED EQU $91
J_SEQUENCE_FULL EQU $92
J_COMMIT EQU $A5
