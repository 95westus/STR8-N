F_NMI_HOLD EQU $F4
F_DC_OWNER EQU $7C29
F_DC_LAST EQU $7C2A
F_DC_BINARY EQU $7C2B
F_DC_SKIP EQU $7C2F
F_BOOT_ACTIVE EQU $7D30
F_JE_HANDLER EQU $7C60
F_J_BEST EQU $7D34
