; MON A/B owns 6A00-6AFF. Never allocate into owner RAM or the F worker.
        INCLUDE "workbench-interface.inc"
        INCLUDE "service-interface.inc"
        INCLUDE "batch-interface.inc"
M_STATE EQU $6A00
M_BANK EQU M_STATE
M_LEN EQU M_STATE+1
M_BAD EQU M_STATE+2
M_CHAR EQU M_STATE+3
M_SKIP_LF EQU M_STATE+4
M_IX EQU M_STATE+5
M_VALUE EQU M_STATE+6
M_FIRST EQU M_STATE+8
M_LAST EQU M_STATE+10
M_ADDR EQU M_STATE+12
M_ROW EQU M_STATE+14
M_CPU EQU M_STATE+16
M_FLAGS EQU M_STATE+17
M_CAPS EQU M_STATE+18
M_MAX EQU M_STATE+19
M_MAX_ROW EQU M_STATE+22
M_INDEX EQU M_STATE+23
M_LEFT EQU M_STATE+25
M_CRC EQU M_STATE+27
M_NIB EQU M_STATE+29
M_DIGITS EQU M_STATE+30
M_FORCE EQU M_STATE+31
M_LINE EQU M_STATE+$40
M_BUFFER EQU M_STATE+$80
M_EDIT EQU M_STATE+$C0
MF_RAM EQU $6B00
MF_ALT EQU $6D00
; Explicit RTCC adapter state; never borrow owner RAM or the F journal frame.
MR_STATE EQU M_STATE+$90
MR_ORA EQU MR_STATE
MR_DDR EQU MR_STATE+1
MR_TRIES EQU MR_STATE+2
MR_COUNT EQU MR_STATE+3
MR_INDEX EQU MR_STATE+4
MR_ERROR EQU MR_STATE+5
MR_BYTE EQU MR_STATE+6
MR_ACK EQU MR_STATE+7
MR_TEMP EQU MR_STATE+8
MR_ONES EQU MR_STATE+9
MR_MAXDAY EQU MR_STATE+10
MR_VALID EQU MR_STATE+11
MR_RESULT EQU MR_STATE+12
MR_RAW EQU MR_STATE+16
MR_TIME EQU MR_STATE+24
MR_BUFFER EQU MR_STATE+32
MR_VORA EQU $7FCF
MR_VDDR EQU $7FC3
MR_VACR EQU $7FCB
M_PTR EQU $E0
M_LINE_LIMIT EQU 40

; All fields below are private BASE1 dependencies, not public ABI additions.
F_SELECTED EQU $F3
F_RESIDENT EQU $7D00
F_ADDR EQU $E2
F_COUNT EQU $EA
F_VECTOR EQU $FE
F_BYTES EQU $7C80
