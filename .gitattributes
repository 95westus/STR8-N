# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf

# Firmware/programmer images must remain byte-for-byte exact.
*.bin binary
*.BIN binary

# Release manifests bind exact source and package bytes across checkouts.
release/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
