# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf

# Firmware/programmer images must remain byte-for-byte exact.
*.bin binary
*.BIN binary

# Release manifests bind exact source and package bytes across checkouts.
release/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Current source provenance and baseline receipts bind exact imported bytes.
src/current/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
tests/baselines/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Installer kits seal exact imported engine and shared implementation bytes.
tools/installer/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
tests/fixtures/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
archive/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Preserve the exact source bytes sealed by uniform-upgrade qualification.
tools/*rc1_uniform*.py -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
tools/*rc1_v1g_component*.py -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/evidence/board-2609-a24/* -text -diff

# Serial prompts and memory-dump ASCII columns retain received trailing spaces.
docs/STR8N_V1_34_BOARD_TRANSCRIPT_2026-09-15.txt whitespace=-blank-at-eol
docs/STR8N_V1_34_FOLLOWUP_BOARD_TRANSCRIPT_2026-09-15.txt whitespace=-blank-at-eol

