# under output/release; qualification evidence remains owner-local.
BUILD/**
__pycache__/

# Generated books are archived in a separate local Git repository, without a remote.
/local-books/
/output/*
!/output/release/
/output/release/*
!/output/release/str8n-v2-a24c1-board-test.zip
/tmp/
